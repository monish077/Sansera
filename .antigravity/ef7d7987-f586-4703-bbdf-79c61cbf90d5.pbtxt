  file_change {
    absolute_path_uri: "file:///src/components/AboutSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  Award, \n  Users, \n  MapPin, \n  ArrowRight, \n  CheckCircle2, \n  Calendar, \n  Sparkles,\n  ChevronRight,\n  TrendingUp,\n  Shield,\n  Layers\n} from \'lucide-react\';\nimport { SANSERA_MILESTONES } from \'../data/sanseraData\';\n\ninterface AboutSectionProps {\n  onOpenFacilities: () => void;\n  onOpenRfq: () => void;\n}\n\nexport const AboutSection: React.FC<AboutSectionProps> = ({ onOpenFacilities, onOpenRfq }) => {\n  const [selectedMilestone, setSelectedMilestone] = useState(SANSERA_MILESTONES.length - 1);\n  const [activeTab, setActiveTab] = useState<\'journey\' | \'manufacturing\' | \'leadership\'>(\'journey\');\n\n  return (\n    <section id=\"about\" className=\"py-24 bg-[#090d16] relative overflow-hidden border-t border-b border-white/5\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/4 left-0 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n      <div className=\"absolute bottom-10 right-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400\"></span>\n              Who We Are\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n              Four Decades of{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400\">\n                Engineering Excellence\n              </span>\n            </h2>\n          </div>\n\n          {/* Founded In Bangalore Badge */}\n          <div className=\"p-4 rounded-2xl bg-gradient-to-br from-slate-900 to-[#0c1220] border border-cyan-500/30 flex items-center gap-4 shadow-xl\">\n            <div className=\"w-12 h-12 rounded-xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-300 font-extrabold text-lg\">\n              1981\n            </div>\n            <div>\n              <div className=\"text-xs font-mono uppercase text-cyan-400 font-bold\">Inception</div>\n              <div className=\"text-sm font-bold text-white flex items-center gap-1\">\n                <MapPin className=\"w-3.5 h-3.5 text-rose-400\" />\n                Bengaluru, India\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Narrative & High-Tech Factory Layout */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-20\">\n          \n          {/* Left: Authoritative Brand Narrative strictly from user prompt */}\n          <div className=\"lg:col-span-6 space-y-6\">\n            <p className=\"text-lg text-slate-200 font-normal leading-relaxed\">\n              For over four decades, Sansera has engineered precision components that power critical applications across automotive and non-automotive industries.\n            </p>\n            <p className=\"text-base text-slate-400 font-light leading-relaxed\">\n              Driven by deep engineering expertise, advanced manufacturing, and continuous innovation, we deliver complex, high-performance products from concept to production. Our integrated capabilities in design, automation, machine building, and manufacturing enable us to solve challenging engineering problems while consistently delivering quality, reliability, and value.\n            </p>\n\n            {/* Core Value Pillars */}\n            <div className=\"grid grid-cols-2 gap-4 pt-2\">\n              <div className=\"p-4 rounded-xl bg-slate-900/60 border border-white/5 space-y-1.5\">\n                <CheckCircle2 className=\"w-5 h-5 text-cyan-400\" />\n                <div className=\"text-sm font-bold text-white\">Full Concept-to-Part</div>\n                <p className=\"text-xs text-slate-400\">Integrated design, forging, tooling, machining & metrology.</p>\n              </div>\n\n              <div className=\"p-4 rounded-xl bg-slate-900/60 border border-white/5 space-y-1.5\">\n                <Sparkles className=\"w-5 h-5 text-blue-400\" />\n                <div className=\"text-sm font-bold text-white\">Proprietary Automation</div>\n                <p className=\"text-xs text-slate-400\">In-house CNC machine building and robotic integration.</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-center gap-4 pt-4\">\n              <button\n                onClick={onOpenFacilities}\n                className=\"px-6 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-sm shadow-lg shadow-cyan-600/30 flex items-center gap-2 transition-all\"\n              >\n                <span>Explore 17+ Facilities</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n\n              <button\n                onClick={onOpenRfq}\n                className=\"px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-white/10 transition-all\"\n              >\n                Connect With Leadership\n              </button>\n            </div>\n          </div>\n\n          {/* Right: Modern Interactive Factory Floor & CNC Shop Representation */}\n          <div className=\"lg:col-span-6\">\n            <div className=\"relative rounded-2xl overflow-hidden bg-slate-900 border border-cyan-500/30 shadow-2xl p-6 space-y-6\">\n              \n              {/* Top Banner with live plant status */}\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <Building2 className=\"w-4 h-4 text-cyan-400\" />\n                  <span className=\"text-xs font-mono font-bold text-slate-200\">\n                    PLANT 07 HQ \342\200\242 38,500 m\302\262 PRECISION CELL\n                  </span>\n                </div>\n                <span className=\"px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-500/40 flex items-center gap-1\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n                  100% OPERATIONAL\n                </span>\n              </div>\n\n              {/* Graphical representation of the advanced factory with robotic lines */}\n              <div className=\"relative h-64 rounded-xl bg-gradient-to-br from-[#060911] to-[#0d1627] border border-white/10 overflow-hidden flex flex-col justify-between p-5\">\n                {/* Central Walkway & Robotic Machine Line Diagram */}\n                <div className=\"absolute inset-0 opacity-40\">\n                  <svg className=\"w-full h-full\" viewBox=\"0 0 400 240\" fill=\"none\">\n                    {/* Perspective Plant Hall */}\n                    <line x1=\"200\" y1=\"20\" x2=\"40\" y2=\"240\" stroke=\"#00b4d8\" strokeWidth=\"1\" strokeDasharray=\"3 3\" />\n                    <line x1=\"200\" y1=\"20\" x2=\"360\" y2=\"240\" stroke=\"#00b4d8\" strokeWidth=\"1\" strokeDasharray=\"3 3\" />\n                    {/* Central Safety Walkway */}\n                    <polygon points=\"190,40 210,40 240,240 160,240\" fill=\"rgba(16, 185, 129, 0.15)\" stroke=\"#10b981\" strokeWidth=\"1\" />\n                    {/* Machine stations left & right */}\n                    <rect x=\"70\" y=\"80\" width=\"60\" height=\"40\" rx=\"4\" fill=\"#1e293b\" stroke=\"#38bdf8\" strokeWidth=\"1\" />\n                    <rect x=\"50\" y=\"140\" width=\"70\" height=\"50\" rx=\"4\" fill=\"#1e293b\" stroke=\"#38bdf8\" strokeWidth=\"1\" />\n                    <rect x=\"270\" y=\"80\" width=\"60\" height=\"40\" rx=\"4\" fill=\"#1e293b\" stroke=\"#fbbf24\" strokeWidth=\"1\" />\n                    <rect x=\"280\" y=\"140\" width=\"70\" height=\"50\" rx=\"4\" fill=\"#1e293b\" stroke=\"#fbbf24\" strokeWidth=\"1\" />\n                    {/* Overhead Crane Rails */}\n                    <line x1=\"20\" y1=\"30\" x2=\"380\" y2=\"30\" stroke=\"#94a3b8\" strokeWidth=\"2\" />\n                    <rect x=\"180\" y=\"24\" width=\"40\" height=\"12\" rx=\"2\" fill=\"#f59e0b\" />\n                  </svg>\n                </div>\n\n                {/* Overlaid stats pill */}\n                <div className=\"relative z-10 flex justify-between items-start\">\n                  <div className=\"space-y-1\">\n                    <div className=\"text-xs text-slate-400 font-mono\">Total Annual Component Run</div>\n                    <div className=\"text-2xl font-mono font-bold text-white\">85.4 Million</div>\n                  </div>\n                  <div className=\"text-right space-y-1\">\n                    <div className=\"text-xs text-slate-400 font-mono\">Forging Capacity</div>\n                    <div className=\"text-lg font-mono font-bold text-cyan-400\">75,000 MT/Yr</div>\n                  </div>\n                </div>\n\n                {/* Bottom badges */}\n                <div className=\"relative z-10 grid grid-cols-3 gap-2 text-center text-[11px] font-mono\">\n                  <div className=\"p-2 rounded bg-black/60 border border-white/10 text-slate-300\">\n                    <span className=\"text-cyan-400 font-bold block\">2,500+</span> CNC Tools\n                  </div>\n                  <div className=\"p-2 rounded bg-black/60 border border-white/10 text-slate-300\">\n                    <span className=\"text-emerald-400 font-bold block\">400+</span> 6-Axis Robots\n                  </div>\n                  <div className=\"p-2 rounded bg-black/60 border border-white/10 text-slate-300\">\n                    <span className=\"text-amber-400 font-bold block\">&lt; 10 PPM</span> Quality Defect\n                  </div>\n                </div>\n              </div>\n\n              {/* Certification tags */}\n              <div className=\"flex flex-wrap gap-2 text-[11px] text-slate-400\">\n                <span className=\"px-2.5 py-1 rounded bg-slate-800 border border-white/5\">IATF 16949:2016</span>\n                <span className=\"px-2.5 py-1 rounded bg-slate-800 border border-white/5\">AS 9100D Aerospace</span>\n                <span className=\"px-2.5 py-1 rounded bg-slate-800 border border-white/5\">ISO 14001:2015</span>\n                <span className=\"px-2.5 py-1 rounded bg-slate-800 border border-white/5\">ISO 45001:2018</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Interactive 4-Decade Milestone Timeline */}\n        <div className=\"p-8 rounded-3xl bg-slate-900/60 border border-white/10 space-y-8\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n            <div>\n              <div className=\"text-xs font-mono uppercase tracking-wider text-cyan-400 font-bold\">\n                Historical Milestones (1981 \342\200\223 2024+)\n              </div>\n              <h3 className=\"text-2xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                A Track Record of Relentless Value Creation\n              </h3>\n            </div>\n            <span className=\"text-xs text-slate-400 font-mono\">\n              Click milestones to explore historical growth\n            </span>\n          </div>\n\n          {/* Timeline Bar */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3\">\n            {SANSERA_MILESTONES.map((milestone, idx) => (\n              <button\n                key={idx}\n                onClick={() => setSelectedMilestone(idx)}\n                className={`p-4 rounded-xl text-left transition-all ${\n                  selectedMilestone === idx\n                    ? \'bg-gradient-to-b from-cyan-950 to-slate-900 border-2 border-cyan-500 shadow-xl shadow-cyan-950/60 scale-[1.02]\'\n                    : \'bg-slate-900/80 border border-white/5 hover:border-cyan-500/30 text-slate-400\'\n                }`}\n              >\n                <div className={`text-xl font-extrabold font-mono mb-1 ${\n                  selectedMilestone === idx ? \'text-cyan-400\' : \'text-slate-300\'\n                }`}>\n                  {milestone.year}\n                </div>\n                <div className=\"text-xs font-bold text-slate-200 line-clamp-1\">\n                  {milestone.title}\n                </div>\n                <div className=\"text-[10px] text-slate-500 mt-1 font-mono\">\n                  {milestone.stats}\n                </div>\n              </button>\n            ))}\n          </div>\n\n          {/* Active Milestone Highlight Card */}\n          <div className=\"p-6 rounded-2xl bg-gradient-to-r from-slate-900 via-[#0b101c] to-slate-900 border border-cyan-500/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-6\">\n            <div className=\"space-y-2 max-w-3xl\">\n              <div className=\"flex items-center gap-3\">\n                <span className=\"px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-mono font-bold border border-cyan-500/40\">\n                  {SANSERA_MILESTONES[selectedMilestone].year} Milestone\n                </span>\n                <span className=\"text-xs text-slate-400 font-mono\">\n                  {SANSERA_MILESTONES[selectedMilestone].stats}\n                </span>\n              </div>\n              <h4 className=\"text-xl font-bold text-white\">\n                {SANSERA_MILESTONES[selectedMilestone].title}\n              </h4>\n              <p className=\"text-sm text-slate-300 leading-relaxed\">\n                {SANSERA_MILESTONES[selectedMilestone].description}\n              </p>\n            </div>\n\n            <div className=\"shrink-0\">\n              <button\n                onClick={onOpenRfq}\n                className=\"px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold uppercase tracking-wider flex items-center gap-2 shadow-lg shadow-cyan-600/30 transition-all\"\n              >\n                <span>Partner With Sansera</span>\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
