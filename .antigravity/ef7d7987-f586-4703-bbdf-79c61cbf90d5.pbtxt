  file_change {
    absolute_path_uri: "file:///src/components/Hero.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { \n  Play, \n  Pause, \n  Volume2, \n  VolumeX, \n  Maximize2, \n  ShieldCheck, \n  ArrowRight, \n  Cpu, \n  Activity, \n  Gauge, \n  Layers, \n  Sparkles,\n  ChevronDown,\n  RotateCw,\n  Compass\n} from \'lucide-react\';\nimport { SANSERA_HERO_STATS } from \'../data/sanseraData\';\n\ninterface HeroProps {\n  onOpenRfq: () => void;\n  onExploreSolutions: () => void;\n  onOpenShowroom: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onOpenRfq, onExploreSolutions, onOpenShowroom }) => {\n  const [isPlaying, setIsPlaying] = useState(true);\n  const [isMuted, setIsMuted] = useState(true);\n  const [activeAngle, setActiveAngle] = useState<\'robotic\' | \'cnc\' | \'forge\' | \'metrology\'>(\'robotic\');\n  const [spindleSpeed, setSpindleSpeed] = useState(12480);\n  const [cycleTime, setCycleTime] = useState(24.6);\n  const [laserIntensity, setLaserIntensity] = useState(98.4);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  // Live telemetry jitter for high-tech precision authenticity\n  useEffect(() => {\n    const interval = setInterval(() => {\n      setSpindleSpeed(prev => Math.floor(12400 + Math.random() * 220));\n      setCycleTime(prev => parseFloat((24.2 + Math.random() * 0.8).toFixed(1)));\n      setLaserIntensity(prev => parseFloat((98.0 + Math.random() * 1.5).toFixed(1)));\n    }, 1500);\n    return () => clearInterval(interval);\n  }, []);\n\n  // Procedural Cinematic Precision Manufacturing Canvas\n  // Simulates 6-axis robotic arms, spark discharges, wireframe component grids, and laser scanning\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let animationFrameId: number;\n    let time = 0;\n\n    const resize = () => {\n      if (!canvas) return;\n      canvas.width = canvas.parentElement?.clientWidth || window.innerWidth;\n      canvas.height = canvas.parentElement?.clientHeight || window.innerHeight;\n    };\n    resize();\n    window.addEventListener(\'resize\', resize);\n\n    const render = () => {\n      time += 0.02;\n      const w = canvas.width;\n      const h = canvas.height;\n\n      // Dark industrial slate canvas\n      ctx.fillStyle = \'#05070c\';\n      ctx.fillRect(0, 0, w, h);\n\n      // 1. Perspective Grid Floor with Depth Glow\n      ctx.strokeStyle = \'rgba(0, 180, 216, 0.06)\';\n      ctx.lineWidth = 1;\n      const horizon = h * 0.55;\n\n      // Horizontal grid lines\n      for (let y = horizon; y < h; y += (y - horizon) * 0.18 + 8) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(w, y);\n        ctx.stroke();\n      }\n\n      // Vanishing point perspective lines\n      const cx = w * 0.5;\n      for (let x = -w * 0.5; x < w * 1.5; x += 90) {\n        ctx.beginPath();\n        ctx.moveTo(cx + (x - cx) * 0.05, horizon);\n        ctx.lineTo(x, h);\n        ctx.stroke();\n      }\n\n      // 2. Simulated 6-Axis Robotic Arm Structure (Fanuc Yellow / Metallic Chrome style)\n      // Base\n      const robotBaseX = w * 0.68;\n      const robotBaseY = horizon + 80;\n\n      // Draw CNC / Machine Cell Silhouette\n      ctx.fillStyle = \'#0a101d\';\n      ctx.strokeStyle = \'rgba(0, 180, 216, 0.2)\';\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.roundRect(robotBaseX - 160, robotBaseY - 140, 320, 260, 12);\n      ctx.fill();\n      ctx.stroke();\n\n      // Industrial Robot Pedestal\n      ctx.fillStyle = \'#1e293b\';\n      ctx.beginPath();\n      ctx.ellipse(robotBaseX, robotBaseY, 60, 20, 0, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.stroke();\n\n      // Kinematic Robot Joints\n      const angle1 = Math.sin(time * 0.8) * 0.35 - 0.4;\n      const arm1Len = 130;\n      const j1X = robotBaseX + Math.sin(angle1) * arm1Len;\n      const j1Y = robotBaseY - Math.cos(angle1) * arm1Len;\n\n      const angle2 = Math.cos(time * 0.9) * 0.5 - 0.8;\n      const arm2Len = 110;\n      const j2X = j1X + Math.sin(angle2) * arm2Len;\n      const j2Y = j1Y + Math.cos(angle2) * arm2Len;\n\n      // End-Effector Tool / Laser Gripper\n      const angle3 = Math.sin(time * 1.2) * 0.4 + 1.2;\n      const toolLen = 45;\n      const toolX = j2X + Math.sin(angle3) * toolLen;\n      const toolY = j2Y + Math.cos(angle3) * toolLen;\n\n      // Draw Lower Arm Link (High-visibility Industrial Yellow)\n      ctx.strokeStyle = \'#f59e0b\';\n      ctx.lineWidth = 22;\n      ctx.lineCap = \'round\';\n      ctx.beginPath();\n      ctx.moveTo(robotBaseX, robotBaseY - 10);\n      ctx.lineTo(j1X, j1Y);\n      ctx.stroke();\n\n      // Lower Arm Shadow / Joint\n      ctx.fillStyle = \'#0f172a\';\n      ctx.beginPath();\n      ctx.arc(robotBaseX, robotBaseY - 10, 16, 0, Math.PI * 2);\n      ctx.arc(j1X, j1Y, 14, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Draw Forearm Link\n      ctx.strokeStyle = \'#fbbf24\';\n      ctx.lineWidth = 14;\n      ctx.beginPath();\n      ctx.moveTo(j1X, j1Y);\n      ctx.lineTo(j2X, j2Y);\n      ctx.stroke();\n\n      // Forearm Joint\n      ctx.fillStyle = \'#38bdf8\';\n      ctx.beginPath();\n      ctx.arc(j2X, j2Y, 9, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Precision End Gripper\n      ctx.strokeStyle = \'#94a3b8\';\n      ctx.lineWidth = 6;\n      ctx.beginPath();\n      ctx.moveTo(j2X, j2Y);\n      ctx.lineTo(toolX, toolY);\n      ctx.stroke();\n\n      // 3. Forged Connecting Rod / Component held by Robot\n      ctx.save();\n      ctx.translate(toolX, toolY);\n      ctx.rotate(time * 0.4);\n      \n      // Wireframe Precision Component (Connecting Rod profile)\n      ctx.strokeStyle = \'rgba(56, 189, 248, 0.85)\';\n      ctx.lineWidth = 2;\n      ctx.fillStyle = \'rgba(14, 165, 233, 0.15)\';\n      ctx.beginPath();\n      // Big end\n      ctx.arc(0, 0, 18, 0, Math.PI * 2);\n      // Rod beam\n      ctx.rect(-5, 0, 10, 45);\n      // Small end\n      ctx.arc(0, 45, 11, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.stroke();\n      ctx.restore();\n\n      // 4. Laser Metrology Scan Beam & Sparks\n      const targetScanX = toolX;\n      const targetScanY = toolY + 15;\n      \n      // Cyan Laser Scan Fan\n      const gradient = ctx.createRadialGradient(targetScanX, targetScanY, 2, targetScanX, targetScanY, 90);\n      gradient.addColorStop(0, \'rgba(0, 240, 255, 0.7)\');\n      gradient.addColorStop(0.3, \'rgba(0, 180, 216, 0.25)\');\n      gradient.addColorStop(1, \'rgba(0, 180, 216, 0)\');\n\n      ctx.fillStyle = gradient;\n      ctx.beginPath();\n      ctx.arc(targetScanX, targetScanY, 80, 0, Math.PI * 2);\n      ctx.fill();\n\n      // Precision Laser Line\n      ctx.strokeStyle = \'#38bdf8\';\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.moveTo(targetScanX - 45, targetScanY);\n      ctx.lineTo(targetScanX + 45, targetScanY);\n      ctx.stroke();\n\n      // Laser Sparks Particles\n      for (let i = 0; i < 7; i++) {\n        const pAngle = (time * 5 + i * 1.3) % (Math.PI * 2);\n        const pDist = 15 + ((time * 80 + i * 25) % 45);\n        const px = targetScanX + Math.cos(pAngle) * pDist;\n        const py = targetScanY + Math.sin(pAngle) * pDist;\n\n        ctx.fillStyle = i % 2 === 0 ? \'#38bdf8\' : \'#fbbf24\';\n        ctx.beginPath();\n        ctx.arc(px, py, (i % 3) + 1.2, 0, Math.PI * 2);\n        ctx.fill();\n      }\n\n      // 5. Cinematic Ambient Lighting & Vignette\n      const vignette = ctx.createRadialGradient(w * 0.5, h * 0.5, w * 0.2, w * 0.5, h * 0.5, w * 0.8);\n      vignette.addColorStop(0, \'rgba(7, 9, 14, 0.15)\');\n      vignette.addColorStop(0.7, \'rgba(7, 9, 14, 0.65)\');\n      vignette.addColorStop(1, \'rgba(7, 9, 14, 0.95)\');\n      ctx.fillStyle = vignette;\n      ctx.fillRect(0, 0, w, h);\n\n      if (isPlaying) {\n        animationFrameId = requestAnimationFrame(render);\n      }\n    };\n\n    render();\n\n    return () => {\n      window.removeEventListener(\'resize\', resize);\n      cancelAnimationFrame(animationFrameId);\n    };\n  }, [isPlaying, activeAngle]);\n\n  return (\n    <section className=\"relative min-h-[92vh] lg:min-h-screen flex flex-col justify-between pt-32 pb-12 overflow-hidden bg-[#07090e]\">\n      {/* Background Video / Cinematic Precision Canvas */}\n      <div className=\"absolute inset-0 z-0 overflow-hidden\">\n        {/* Canvas renderer for live animated robotic machining & metrology */}\n        <canvas \n          ref={canvasRef} \n          className=\"w-full h-full object-cover opacity-85 scale-105 transition-all duration-1000\"\n        />\n\n        {/* Subtle Dark Overlay (30\342\200\22340% per user instructions) for crystal clear readability */}\n        <div className=\"absolute inset-0 bg-gradient-to-r from-[#07090e]/95 via-[#07090e]/75 to-[#07090e]/50 backdrop-brightness-95 pointer-events-none\" />\n        <div className=\"absolute inset-0 bg-gradient-to-t from-[#07090e] via-transparent to-[#07090e]/70 pointer-events-none\" />\n        \n        {/* Engineering blueprint grid lines */}\n        <div \n          className=\"absolute inset-0 opacity-15 pointer-events-none\" \n          style={{\n            backgroundImage: `radial-gradient(circle at 1px 1px, rgba(0, 180, 216, 0.4) 1px, transparent 0)`,\n            backgroundSize: \'32px 32px\'\n          }}\n        />\n      </div>\n\n      {/* Main Content Container */}\n      <div className=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex-1 flex flex-col justify-center my-auto\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n          \n          {/* Left Column: Headlines, Value Proposition & Actions */}\n          <div className=\"lg:col-span-8 space-y-7\">\n            \n            {/* Top Subtitle Badge */}\n            <div className=\"inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cyan-950/70 border border-cyan-500/30 backdrop-blur-md shadow-lg shadow-cyan-950/40\">\n              <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-ping\"></span>\n              <span className=\"text-xs font-mono font-semibold uppercase tracking-widest text-cyan-300\">\n                Global Tier-1 Engineering & Manufacturing\n              </span>\n            </div>\n\n            {/* Main Punchy Display Headline */}\n            <h1 className=\"text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight text-white leading-[1.08] font-[\'Space_Grotesk\',sans-serif]\">\n              Engineering Precision.{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-sky-300\">\n                Driving Tomorrow\342\200\231s\n              </span>{\' \'}\n              Industries.\n            </h1>\n\n            {/* Subtitle strictly preserving user prompt copy */}\n            <p className=\"text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl\">\n              An engineering-led manufacturer of precision components and systems, powering automotive and industrial innovation through advanced design, manufacturing, and automation.\n            </p>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-wrap items-center gap-4 pt-2\">\n              <button\n                onClick={onExploreSolutions}\n                className=\"group px-7 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 via-blue-600 to-cyan-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-sm tracking-wide shadow-xl shadow-cyan-600/30 hover:shadow-cyan-500/50 transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center gap-2.5\"\n              >\n                <span>Explore Our Solutions</span>\n                <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n              </button>\n\n              <button\n                onClick={onOpenRfq}\n                className=\"px-7 py-3.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-100 font-semibold text-sm border border-white/15 hover:border-cyan-500/50 backdrop-blur-md transition-all transform hover:-translate-y-0.5\"\n              >\n                Contact Our Experts\n              </button>\n\n              <button\n                onClick={onOpenShowroom}\n                className=\"px-5 py-3.5 rounded-xl bg-cyan-950/40 hover:bg-cyan-900/60 text-cyan-300 text-sm font-medium border border-cyan-500/30 flex items-center gap-2 transition-colors\"\n              >\n                <RotateCw className=\"w-4 h-4 text-cyan-400\" />\n                <span>3D Component Lab</span>\n              </button>\n            </div>\n\n            {/* Key Quality Standards / Certifications Strip */}\n            <div className=\"flex flex-wrap items-center gap-6 pt-3 text-xs text-slate-400 font-medium\">\n              <span className=\"flex items-center gap-1.5 text-slate-300\">\n                <ShieldCheck className=\"w-4 h-4 text-cyan-400\" />\n                IATF 16949:2016 Certified\n              </span>\n              <span className=\"flex items-center gap-1.5 text-slate-300\">\n                <ShieldCheck className=\"w-4 h-4 text-blue-400\" />\n                AS 9100D Aerospace Standard\n              </span>\n              <span className=\"flex items-center gap-1.5 text-slate-300\">\n                <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n                ISO 14001:2015 Environmental\n              </span>\n            </div>\n          </div>\n\n          {/* Right Column: Live Factory Robotic Telemetry HUD */}\n          <div className=\"lg:col-span-4 hidden lg:block\">\n            <div className=\"p-6 rounded-2xl bg-[#0b101d]/85 border border-cyan-500/25 shadow-2xl shadow-cyan-950/50 backdrop-blur-xl space-y-5\">\n              \n              {/* Header */}\n              <div className=\"flex items-center justify-between border-b border-white/10 pb-3\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n                  <span className=\"text-xs font-mono font-bold uppercase tracking-wider text-slate-200\">\n                    Live Robotic Cell 07\n                  </span>\n                </div>\n                <span className=\"text-[11px] font-mono px-2 py-0.5 rounded bg-cyan-950/80 text-cyan-300 border border-cyan-500/30\">\n                  4K / 60 FPS\n                </span>\n              </div>\n\n              {/* Live telemetry counters */}\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div className=\"p-3 rounded-xl bg-slate-900/80 border border-white/5 space-y-1\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-slate-400\">\n                    <Gauge className=\"w-3.5 h-3.5 text-cyan-400\" />\n                    <span>Spindle Velocity</span>\n                  </div>\n                  <div className=\"text-lg font-mono font-bold text-white\">\n                    {spindleSpeed} <span className=\"text-xs font-normal text-slate-400\">RPM</span>\n                  </div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-900/80 border border-white/5 space-y-1\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-slate-400\">\n                    <Activity className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    <span>Cycle Time</span>\n                  </div>\n                  <div className=\"text-lg font-mono font-bold text-emerald-400\">\n                    {cycleTime} <span className=\"text-xs font-normal text-slate-400\">sec</span>\n                  </div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-900/80 border border-white/5 space-y-1\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-slate-400\">\n                    <Cpu className=\"w-3.5 h-3.5 text-amber-400\" />\n                    <span>Laser Alignment</span>\n                  </div>\n                  <div className=\"text-lg font-mono font-bold text-amber-300\">\n                    {laserIntensity}%\n                  </div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-900/80 border border-white/5 space-y-1\">\n                  <div className=\"flex items-center gap-1.5 text-[11px] text-slate-400\">\n                    <Layers className=\"w-3.5 h-3.5 text-blue-400\" />\n                    <span>Tolerance Grade</span>\n                  </div>\n                  <div className=\"text-lg font-mono font-bold text-cyan-300\">\n                    \302\261 1.5 <span className=\"text-xs font-normal text-slate-400\">\316\274m</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Camera Angle Switcher */}\n              <div className=\"space-y-2 pt-1\">\n                <span className=\"text-[11px] font-mono text-slate-400 uppercase tracking-wider block\">\n                  Feed View Angle\n                </span>\n                <div className=\"grid grid-cols-4 gap-1.5\">\n                  {[\n                    { id: \'robotic\', label: \'6-Axis\' },\n                    { id: \'cnc\', label: \'5-Axis CNC\' },\n                    { id: \'forge\', label: \'4000T\' },\n                    { id: \'metrology\', label: \'Zeiss\' },\n                  ].map(angle => (\n                    <button\n                      key={angle.id}\n                      onClick={() => setActiveAngle(angle.id as any)}\n                      className={`px-2 py-1.5 text-[10px] font-mono font-semibold rounded-lg transition-all ${\n                        activeAngle === angle.id\n                          ? \'bg-cyan-500 text-black font-bold shadow-md shadow-cyan-500/30\'\n                          : \'bg-slate-900/80 text-slate-400 hover:text-white border border-white/5\'\n                      }`}\n                    >\n                      {angle.label}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Playback Controls Strip */}\n              <div className=\"flex items-center justify-between pt-2 border-t border-white/10 text-slate-400\">\n                <div className=\"flex items-center gap-3\">\n                  <button\n                    onClick={() => setIsPlaying(!isPlaying)}\n                    className=\"p-1.5 rounded-lg bg-slate-900 hover:text-cyan-400 text-slate-300 border border-white/10\"\n                    title={isPlaying ? \'Pause Feed\' : \'Resume Feed\'}\n                  >\n                    {isPlaying ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n                  </button>\n\n                  <button\n                    onClick={() => setIsMuted(!isMuted)}\n                    className=\"p-1.5 rounded-lg bg-slate-900 hover:text-cyan-400 text-slate-300 border border-white/10\"\n                    title={isMuted ? \'Unmute Audio\' : \'Mute Audio\'}\n                  >\n                    {isMuted ? <VolumeX className=\"w-3.5 h-3.5\" /> : <Volume2 className=\"w-3.5 h-3.5\" />}\n                  </button>\n                </div>\n\n                <span className=\"text-[10px] font-mono text-cyan-400 flex items-center gap-1\">\n                  <Sparkles className=\"w-3 h-3\" />\n                  Auto-Loop Active\n                </span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Base KPI Strip / Heritage Bar */}\n      <div className=\"relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-12\">\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 p-5 rounded-2xl bg-[#0b101c]/80 border border-white/10 backdrop-blur-xl shadow-2xl\">\n          {SANSERA_HERO_STATS.map((stat, idx) => (\n            <div \n              key={idx} \n              className={`space-y-1 ${idx !== 0 ? \'md:border-l md:border-white/10 md:pl-6\' : \'\'}`}\n            >\n              <div className=\"text-2xl sm:text-3xl lg:text-4xl font-extrabold font-[\'Space_Grotesk\',sans-serif] text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-300\">\n                {stat.value}\n              </div>\n              <div className=\"text-xs sm:text-sm font-bold text-slate-200 tracking-tight\">\n                {stat.label}\n              </div>\n              <div className=\"text-[11px] text-slate-400 hidden sm:block\">\n                {stat.sub}\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
