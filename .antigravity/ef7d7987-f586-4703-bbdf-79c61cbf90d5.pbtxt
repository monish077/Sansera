  file_change {
    absolute_path_uri: "file:///src/components/ProductSegments.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { \n  Car, \n  Plane, \n  Tractor, \n  Zap, \n  RotateCw, \n  Maximize2, \n  Layers, \n  Download, \n  FileText, \n  Check, \n  Sparkles, \n  ArrowRight,\n  Shield,\n  Gauge\n} from \'lucide-react\';\nimport { SANSERA_PRODUCTS } from \'../data/sanseraData\';\nimport { ProductItem, ProductSegmentId } from \'../types\';\n\ninterface ProductSegmentsProps {\n  onOpenRfqWithProduct: (product: ProductItem) => void;\n  onOpenProductModal: (product: ProductItem) => void;\n  initialSegment?: ProductSegmentId;\n}\n\nexport const ProductSegments: React.FC<ProductSegmentsProps> = ({ \n  onOpenRfqWithProduct, \n  onOpenProductModal,\n  initialSegment = \'automotive\' \n}) => {\n  const [activeCategory, setActiveCategory] = useState<ProductSegmentId>(initialSegment);\n  const [selectedProduct, setSelectedProduct] = useState<ProductItem>(SANSERA_PRODUCTS[0]);\n  const [isExplodedView, setIsExplodedView] = useState(false);\n  const [isWireframe, setIsWireframe] = useState(false);\n  const [rotationAngle, setRotationAngle] = useState(0);\n  const [isAutoRotating, setIsAutoRotating] = useState(true);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  const categories: { id: ProductSegmentId; label: string; icon: any; count: number; badge: string }[] = [\n    { id: \'automotive\', label: \'Automotive\', icon: Car, count: 3, badge: \'ICE & Hybrid\' },\n    { id: \'aerospace\', label: \'Aerospace\', icon: Plane, count: 1, badge: \'AS9100D Certified\' },\n    { id: \'non-automotive\', label: \'Non-Automotive\', icon: Tractor, count: 1, badge: \'Agri & Industrial\' },\n    { id: \'ev-mobility\', label: \'EV & Clean Mobility\', icon: Zap, count: 1, badge: \'Next-Gen E-Axle\' },\n  ];\n\n  const filteredProducts = SANSERA_PRODUCTS.filter(p => p.category === activeCategory);\n\n  useEffect(() => {\n    if (filteredProducts.length > 0) {\n      setSelectedProduct(filteredProducts[0]);\n    }\n  }, [activeCategory]);\n\n  // Interactive 3D Canvas Rendering of the Selected Mechanical Component (Crankshaft, Connecting Rod, Rocker Arm, Actuator)\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let animationFrameId: number;\n\n    const render = () => {\n      if (isAutoRotating) {\n        setRotationAngle(prev => (prev + 0.015) % (Math.PI * 2));\n      }\n\n      const w = canvas.width;\n      const h = canvas.height;\n      ctx.clearRect(0, 0, w, h);\n\n      const cx = w * 0.5;\n      const cy = h * 0.5;\n\n      // Dark metallic backdrop gradient\n      const bg = ctx.createRadialGradient(cx, cy, 30, cx, cy, w * 0.5);\n      bg.addColorStop(0, \'rgba(15, 23, 42, 0.9)\');\n      bg.addColorStop(0.8, \'rgba(7, 9, 14, 0.98)\');\n      bg.addColorStop(1, \'#05070c\');\n      ctx.fillStyle = bg;\n      ctx.fillRect(0, 0, w, h);\n\n      // Coordinate Measurement / Blueprint grid\n      ctx.strokeStyle = \'rgba(0, 180, 216, 0.12)\';\n      ctx.lineWidth = 1;\n      for (let x = 20; x < w; x += 40) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, h);\n        ctx.stroke();\n      }\n      for (let y = 20; y < h; y += 40) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(w, y);\n        ctx.stroke();\n      }\n\n      // Drawing 3D Precision Engineered CAD Representation based on selected product type\n      ctx.save();\n      ctx.translate(cx, cy);\n\n      const rad = rotationAngle;\n      const cosA = Math.cos(rad);\n      const sinA = Math.sin(rad);\n\n      const explodedShift = isExplodedView ? 48 : 0;\n\n      if (selectedProduct.cadModelType === \'crankshaft\' || activeCategory === \'automotive\') {\n        // --- 3D MONOBLOCK CRANKSHAFT RENDERING ---\n        // Main Shaft Centerline\n        const shaftLength = 220;\n        \n        // Gradient for forged steel chrome\n        const steelGrad = ctx.createLinearGradient(-100, -50, 100, 50);\n        steelGrad.addColorStop(0, \'#64748b\');\n        steelGrad.addColorStop(0.3, \'#f8fafc\');\n        steelGrad.addColorStop(0.7, \'#94a3b8\');\n        steelGrad.addColorStop(1, \'#334155\');\n\n        ctx.fillStyle = isWireframe ? \'transparent\' : steelGrad;\n        ctx.strokeStyle = isWireframe ? \'#38bdf8\' : \'#cbd5e1\';\n        ctx.lineWidth = isWireframe ? 1.5 : 2;\n\n        // Counterweights (web lobes)\n        for (let i = -1; i <= 1; i += 2) {\n          const webX = i * (45 + explodedShift * 0.4);\n          const webOffset = Math.sin(rad + i) * 35;\n\n          ctx.save();\n          ctx.beginPath();\n          // Counterweight lobe profile\n          ctx.arc(webX * cosA, webOffset + (i * 20), 38, 0, Math.PI * 2);\n          if (!isWireframe) ctx.fill();\n          ctx.stroke();\n\n          // Induction hardening ring\n          ctx.strokeStyle = \'#00b4d8\';\n          ctx.lineWidth = 1;\n          ctx.beginPath();\n          ctx.arc(webX * cosA, webOffset + (i * 20), 32, 0, Math.PI * 2);\n          ctx.stroke();\n          ctx.restore();\n        }\n\n        // Main Bearing Journals\n        ctx.fillStyle = isWireframe ? \'transparent\' : \'#e2e8f0\';\n        ctx.beginPath();\n        ctx.rect(-shaftLength * 0.45 * cosA, -16, shaftLength * 0.9 * cosA, 32);\n        if (!isWireframe) ctx.fill();\n        ctx.stroke();\n\n        // Timing Gear on Snout (with teeth)\n        const gearX = (shaftLength * 0.45 + explodedShift) * cosA;\n        ctx.fillStyle = \'#475569\';\n        ctx.beginPath();\n        ctx.arc(gearX, 0, 26, 0, Math.PI * 2);\n        if (!isWireframe) ctx.fill();\n        ctx.stroke();\n\n        // Crankpin journal (offset)\n        const pinY = Math.sin(rad) * 42;\n        ctx.fillStyle = \'#38bdf8\';\n        ctx.beginPath();\n        ctx.arc(0, pinY, 18, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n\n      } else if (selectedProduct.cadModelType === \'connecting-rod\') {\n        // --- 3D FRACTURE-SPLIT CONNECTING ROD ---\n        const rodLength = 160;\n        const bigEndRadius = 34;\n        const smallEndRadius = 20;\n\n        // Big-end split cap (exploded if active)\n        const capShift = isExplodedView ? 45 : 0;\n        \n        ctx.fillStyle = isWireframe ? \'transparent\' : \'#94a3b8\';\n        ctx.strokeStyle = \'#38bdf8\';\n        ctx.lineWidth = 2;\n\n        // Rod H-Beam\n        ctx.beginPath();\n        ctx.rect(-10 * cosA, -rodLength * 0.35, 20 * cosA, rodLength * 0.7);\n        if (!isWireframe) ctx.fill();\n        ctx.stroke();\n\n        // Small End (Piston pin end)\n        ctx.beginPath();\n        ctx.arc(0, -rodLength * 0.45, smallEndRadius, 0, Math.PI * 2);\n        if (!isWireframe) ctx.fill();\n        ctx.stroke();\n\n        // Small end bronze bushing\n        ctx.strokeStyle = \'#f59e0b\';\n        ctx.beginPath();\n        ctx.arc(0, -rodLength * 0.45, smallEndRadius - 6, 0, Math.PI * 2);\n        ctx.stroke();\n\n        // Big End (Crankpin journal)\n        ctx.beginPath();\n        ctx.arc(0, rodLength * 0.35 + capShift, bigEndRadius, 0, Math.PI * 2);\n        if (!isWireframe) ctx.fill();\n        ctx.stroke();\n\n        // Fracture-split seam\n        ctx.strokeStyle = \'#f43f5e\';\n        ctx.lineWidth = 1.5;\n        ctx.beginPath();\n        ctx.moveTo(-bigEndRadius, rodLength * 0.35 + capShift);\n        ctx.lineTo(bigEndRadius, rodLength * 0.35 + capShift);\n        ctx.stroke();\n\n      } else {\n        // --- 3D AEROSPACE ACTUATOR / TITANIUM FITTING ---\n        ctx.fillStyle = isWireframe ? \'transparent\' : \'#64748b\';\n        ctx.strokeStyle = \'#38bdf8\';\n        ctx.lineWidth = 2;\n\n        // 5-Axis complex contour housing\n        ctx.beginPath();\n        ctx.roundRect(-70 * cosA, -50, 140 * cosA, 100, 16);\n        if (!isWireframe) ctx.fill();\n        ctx.stroke();\n\n        // Precision actuator cylinder bore\n        ctx.fillStyle = \'#0f172a\';\n        ctx.beginPath();\n        ctx.arc(0, 0, 32, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n\n        // Mounting flange lugs\n        for (let j = 0; j < 4; j++) {\n          const lAngle = (j * Math.PI) / 2 + rad * 0.5;\n          const lx = Math.cos(lAngle) * 55;\n          const ly = Math.sin(lAngle) * 45;\n          ctx.beginPath();\n          ctx.arc(lx, ly, 8, 0, Math.PI * 2);\n          ctx.stroke();\n        }\n      }\n\n      // Hotspot Measurement Callouts\n      if (!isWireframe) {\n        ctx.fillStyle = \'#00b4d8\';\n        ctx.font = \'10px JetBrains Mono, monospace\';\n        ctx.fillText(\'Ra < 0.08 \316\274m\', 50, -40);\n        ctx.fillText(\'IT3 Bore\', -90, 60);\n\n        ctx.strokeStyle = \'#00b4d8\';\n        ctx.beginPath();\n        ctx.arc(45, -43, 3, 0, Math.PI * 2);\n        ctx.fill();\n      }\n\n      ctx.restore();\n\n      animationFrameId = requestAnimationFrame(render);\n    };\n\n    render();\n\n    return () => cancelAnimationFrame(animationFrameId);\n  }, [selectedProduct, isExplodedView, isWireframe, isAutoRotating, rotationAngle, activeCategory]);\n\n  return (\n    <section id=\"segments\" className=\"py-24 bg-[#07090e] relative overflow-hidden\">\n      {/* Background glow accents */}\n      <div className=\"absolute top-0 right-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header with crisp typography from user reference */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16 space-y-4\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/70 border border-cyan-500/30 text-xs font-mono font-bold tracking-widest text-cyan-300 uppercase\">\n            <Sparkles className=\"w-3.5 h-3.5 text-cyan-400\" />\n            Our Product Segments\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n            Explore Our Wide{\' \'}\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-sky-300\">\n              Array Of Product Segments\n            </span>\n          </h2>\n          <p className=\"text-base sm:text-lg text-slate-400 font-normal\">\n            Manufacturing safety-critical forged and CNC-machined components across automotive powertrains, aerospace flight controls, and next-generation clean mobility.\n          </p>\n        </div>\n\n        {/* Segment Category Switcher Tabs */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto mb-12\">\n          {categories.map(cat => {\n            const Icon = cat.icon;\n            const isActive = activeCategory === cat.id;\n            return (\n              <button\n                key={cat.id}\n                onClick={() => setActiveCategory(cat.id)}\n                className={`p-4 rounded-2xl transition-all flex flex-col items-center gap-2 border text-center relative overflow-hidden ${\n                  isActive\n                    ? \'bg-gradient-to-b from-cyan-950/90 to-slate-900 border-cyan-500/80 shadow-xl shadow-cyan-950/50 scale-[1.02]\'\n                    : \'bg-slate-900/60 border-white/5 hover:border-cyan-500/30 text-slate-400 hover:text-white\'\n                }`}\n              >\n                <div className={`p-2.5 rounded-xl ${isActive ? \'bg-cyan-500 text-black shadow-lg shadow-cyan-500/30\' : \'bg-slate-800 text-slate-300\'}`}>\n                  <Icon className=\"w-5 h-5\" />\n                </div>\n                <div className=\"font-bold text-sm text-white tracking-tight\">{cat.label}</div>\n                <span className=\"text-[11px] font-mono px-2 py-0.5 rounded-full bg-slate-800/80 text-cyan-300 border border-white/5\">\n                  {cat.badge}\n                </span>\n                {isActive && (\n                  <div className=\"absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-400 to-blue-500\"></div>\n                )}\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Interactive 3D Visualizer & Technical Spec Panel */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-16\">\n          \n          {/* Left 3D Interactive Component Canvas */}\n          <div className=\"lg:col-span-7 rounded-3xl bg-gradient-to-b from-[#0a0f1c] to-[#060810] border border-cyan-500/30 p-6 shadow-2xl flex flex-col justify-between relative overflow-hidden\">\n            \n            {/* Header HUD */}\n            <div className=\"flex items-center justify-between z-10\">\n              <div className=\"space-y-0.5\">\n                <span className=\"text-[11px] font-mono font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5\">\n                  <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-ping\"></span>\n                  Interactive 3D Cad Inspector\n                </span>\n                <div className=\"text-lg font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                  {selectedProduct.name}\n                </div>\n              </div>\n\n              {/* 3D Controls */}\n              <div className=\"flex items-center gap-2\">\n                <button\n                  onClick={() => setIsExplodedView(!isExplodedView)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all border ${\n                    isExplodedView \n                      ? \'bg-cyan-500 text-black border-cyan-400 font-bold\' \n                      : \'bg-slate-900 text-slate-300 border-white/10 hover:border-cyan-500/40\'\n                  }`}\n                  title=\"Toggle exploded assembly\"\n                >\n                  <span className=\"flex items-center gap-1\">\n                    <Layers className=\"w-3.5 h-3.5\" />\n                    {isExplodedView ? \'Assembled\' : \'Exploded\'}\n                  </span>\n                </button>\n\n                <button\n                  onClick={() => setIsWireframe(!isWireframe)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-mono font-semibold transition-all border ${\n                    isWireframe \n                      ? \'bg-cyan-500 text-black border-cyan-400 font-bold\' \n                      : \'bg-slate-900 text-slate-300 border-white/10 hover:border-cyan-500/40\'\n                  }`}\n                  title=\"Toggle CAD wireframe mode\"\n                >\n                  {isWireframe ? \'Solid CAD\' : \'Wireframe\'}\n                </button>\n\n                <button\n                  onClick={() => setIsAutoRotating(!isAutoRotating)}\n                  className={`p-2 rounded-lg text-xs border ${\n                    isAutoRotating ? \'bg-slate-800 text-cyan-400 border-cyan-500/40\' : \'bg-slate-900 text-slate-400 border-white/10\'\n                  }`}\n                  title=\"360\302\260 Auto-Rotate\"\n                >\n                  <RotateCw className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* 3D Canvas Box */}\n            <div className=\"relative h-80 my-4 flex items-center justify-center rounded-2xl overflow-hidden border border-white/5\">\n              <canvas\n                ref={canvasRef}\n                width={560}\n                height={320}\n                className=\"w-full h-full object-contain cursor-grab active:cursor-grabbing\"\n              />\n\n              {/* Technical floating badges */}\n              <div className=\"absolute bottom-3 left-3 bg-black/70 backdrop-blur-md p-2 rounded-lg border border-white/10 text-[10px] font-mono text-slate-300 space-y-0.5\">\n                <div>Tolerances: <span className=\"text-cyan-400 font-bold\">{selectedProduct.tolerances}</span></div>\n                <div>Metallurgy: <span className=\"text-slate-200\">{selectedProduct.specs.metallurgy}</span></div>\n              </div>\n\n              <div className=\"absolute bottom-3 right-3 bg-black/70 backdrop-blur-md p-2 rounded-lg border border-white/10 text-[10px] font-mono text-emerald-400 font-bold\">\n                100% Crack Checked (MPI)\n              </div>\n            </div>\n\n            {/* Bottom Component Selector Pills */}\n            <div className=\"flex items-center gap-2 overflow-x-auto pb-1\">\n              {filteredProducts.map(prod => (\n                <button\n                  key={prod.id}\n                  onClick={() => setSelectedProduct(prod)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-all border ${\n                    selectedProduct.id === prod.id\n                      ? \'bg-cyan-950 text-cyan-300 border-cyan-400 shadow-md\'\n                      : \'bg-slate-900/80 text-slate-400 border-white/5 hover:text-white\'\n                  }`}\n                >\n                  {prod.name.split(\' \')[0]} {prod.name.split(\' \')[1]}\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Right Technical Specification & Material Details */}\n          <div className=\"lg:col-span-5 rounded-3xl bg-slate-900/80 border border-white/10 p-7 shadow-2xl flex flex-col justify-between space-y-6\">\n            <div className=\"space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-mono font-bold px-2.5 py-1 rounded bg-blue-950 text-blue-300 border border-blue-500/30\">\n                  {selectedProduct.categoryLabel}\n                </span>\n                <span className=\"text-xs font-mono text-slate-400\">\n                  Vol: <strong className=\"text-white\">{selectedProduct.annualVolume}</strong>\n                </span>\n              </div>\n\n              <h3 className=\"text-2xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                {selectedProduct.name}\n              </h3>\n\n              <p className=\"text-sm text-slate-300 leading-relaxed font-light\">\n                {selectedProduct.description}\n              </p>\n\n              {/* Engineering Specs Grid */}\n              <div className=\"grid grid-cols-2 gap-3 pt-2\">\n                <div className=\"p-3 rounded-xl bg-[#060810] border border-white/5 space-y-1\">\n                  <span className=\"text-[11px] font-mono text-slate-400 block\">Critical Tolerance</span>\n                  <span className=\"text-xs font-mono font-bold text-cyan-400\">{selectedProduct.tolerances}</span>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#060810] border border-white/5 space-y-1\">\n                  <span className=\"text-[11px] font-mono text-slate-400 block\">Finished Weight</span>\n                  <span className=\"text-xs font-mono font-bold text-white\">{selectedProduct.weightRange}</span>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#060810] border border-white/5 space-y-1\">\n                  <span className=\"text-[11px] font-mono text-slate-400 block\">Surface Roughness</span>\n                  <span className=\"text-xs font-mono font-bold text-emerald-400\">{selectedProduct.specs.surfaceRoughness}</span>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-[#060810] border border-white/5 space-y-1\">\n                  <span className=\"text-[11px] font-mono text-slate-400 block\">Heat Treatment</span>\n                  <span className=\"text-xs font-mono font-bold text-amber-300\">{selectedProduct.specs.heatTreatment}</span>\n                </div>\n              </div>\n\n              {/* Engineering Highlights */}\n              <div className=\"space-y-2 pt-1\">\n                <span className=\"text-xs font-mono font-bold text-slate-400 uppercase tracking-wider block\">\n                  Manufacturing Highlights\n                </span>\n                <ul className=\"space-y-1.5\">\n                  {selectedProduct.highlights.map((hl, idx) => (\n                    <li key={idx} className=\"flex items-start gap-2 text-xs text-slate-300\">\n                      <Check className=\"w-3.5 h-3.5 text-cyan-400 shrink-0 mt-0.5\" />\n                      <span>{hl}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            </div>\n\n            {/* Actions for this component */}\n            <div className=\"pt-4 border-t border-white/10 flex items-center gap-3\">\n              <button\n                onClick={() => onOpenRfqWithProduct(selectedProduct)}\n                className=\"flex-1 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-600/30 flex items-center justify-center gap-2 transition-all\"\n              >\n                <span>Request Component RFQ</span>\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n\n              <button\n                onClick={() => onOpenProductModal(selectedProduct)}\n                className=\"p-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-white/10 hover:text-cyan-400 transition-all\"\n                title=\"Full Engineering Datasheet\"\n              >\n                <FileText className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Bottom Product Grid Cards for quick inspection */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n          {SANSERA_PRODUCTS.slice(0, 3).map(prod => (\n            <div\n              key={prod.id}\n              onClick={() => {\n                setActiveCategory(prod.category);\n                setSelectedProduct(prod);\n              }}\n              className={`p-6 rounded-2xl border transition-all cursor-pointer group ${\n                selectedProduct.id === prod.id\n                  ? \'bg-cyan-950/40 border-cyan-500/80 shadow-xl shadow-cyan-950/50\'\n                  : \'bg-slate-900/60 border-white/5 hover:border-cyan-500/40\'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-3\">\n                <span className=\"text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-cyan-400 border border-white/5\">\n                  {prod.categoryLabel}\n                </span>\n                <span className=\"text-xs font-mono text-slate-400\">{prod.tolerances}</span>\n              </div>\n              <h4 className=\"text-lg font-bold text-white group-hover:text-cyan-400 transition-colors font-[\'Space_Grotesk\',sans-serif]\">\n                {prod.name}\n              </h4>\n              <p className=\"text-xs text-slate-400 mt-2 line-clamp-2\">\n                {prod.description}\n              </p>\n              <div className=\"mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-xs text-cyan-400 font-semibold\">\n                <span>View CAD & Specs</span>\n                <ArrowRight className=\"w-3.5 h-3.5 group-hover:translate-x-1 transition-transform\" />\n              </div>\n            </div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
