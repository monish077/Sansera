        }
        lines {
          text: "  useEffect(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const interval = setInterval(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
