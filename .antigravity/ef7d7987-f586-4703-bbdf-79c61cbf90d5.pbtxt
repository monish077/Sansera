      replacement_content: "import React, { useState } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Hero } from \'./components/Hero\';\nimport { AboutSection } from \'./components/AboutSection\';\nimport { ProductSegments } from \'./components/ProductSegments\';\nimport { CapabilitiesSection } from \'./components/CapabilitiesSection\';\nimport { AutomationSection } from \'./components/AutomationSection\';\nimport { FacilitiesMap } from \'./components/FacilitiesMap\';\nimport { OEMPartners } from \'./components/OEMPartners\';\nimport { SustainabilitySection } from \'./components/SustainabilitySection\';\nimport { InvestorPortal } from \'./components/InvestorPortal\';\nimport { Footer } from \'./components/Footer\';\nimport { RfqModal } from \'./components/RfqModal\';\nimport { ProductModal } from \'./components/ProductModal\';\nimport { ProductItem, ProductSegmentId } from \'./types\';\n\nexport default function App() {\n  const [isRfqOpen, setIsRfqOpen] = useState(false);\n  const [selectedRfqProduct, setSelectedRfqProduct] = useState<ProductItem | null>(null);\n  const [selectedModalProduct, setSelectedModalProduct] = useState<ProductItem | null>(null);\n  const [activeSegmentFilter, setActiveSegmentFilter] = useState<ProductSegmentId>(\'automotive\');\n\n  const handleOpenRfq = (product?: ProductItem) => {\n    setSelectedRfqProduct(product || null);\n    setIsRfqOpen(true);\n  };\n\n  const handleOpenProductModal = (product: ProductItem) => {\n    setSelectedModalProduct(product);\n  };\n\n  const handleSelectSegment = (segmentId: string) => {\n    setActiveSegmentFilter(segmentId as ProductSegmentId);\n    const elem = document.getElementById(\'segments\');\n    if (elem) {\n      elem.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  const handleScrollToSection = (sectionId: string) => {\n    const elem = document.getElementById(sectionId);\n    if (elem) {\n      elem.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#07090e] text-slate-100 selection:bg-cyan-500 selection:text-black font-sans antialiased\">\n      {/* Fixed Navigation Bar with Stock Ticker & Mega Menu */}\n      <Navbar\n        onOpenRfq={() => handleOpenRfq()}\n        onOpenFinancials={() => handleScrollToSection(\'investors\')}\n        onSelectSegment={handleSelectSegment}\n      />\n\n      {/* Hero Section with Canvas Manufacturing Video/Simulation & HUD */}\n      <Hero\n        onOpenRfq={() => handleOpenRfq()}\n        onExploreSolutions={() => handleScrollToSection(\'segments\')}\n        onOpenShowroom={() => handleScrollToSection(\'segments\')}\n      />\n\n      {/* About Section: Four Decades, Milestones, Plant Floor */}\n      <AboutSection\n        onOpenFacilities={() => handleScrollToSection(\'facilities\')}\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* Product Segments with Interactive 3D CAD Inspector */}\n      <ProductSegments\n        initialSegment={activeSegmentFilter}\n        onOpenRfqWithProduct={(prod) => handleOpenRfq(prod)}\n        onOpenProductModal={handleOpenProductModal}\n      />\n\n      {/* Core Capabilities: 4,000T Forging, CNC, Simulation, Metrology */}\n      <CapabilitiesSection\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* Proprietary In-House Machine Building & Automation */}\n      <AutomationSection\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* Global Manufacturing Footprint: 17+ Facilities Map */}\n      <FacilitiesMap\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* Global Tier-1 OEM Partners & Case Studies */}\n      <OEMPartners\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* ESG, Renewable Solar Power & Sustainability */}\n      <SustainabilitySection\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* Investor Relations, Audited Financials & Stock Performance */}\n      <InvestorPortal\n        onOpenRfq={() => handleOpenRfq()}\n      />\n\n      {/* Corporate Footer & Global Headquarters Contact */}\n      <Footer\n        onOpenRfq={() => handleOpenRfq()}\n        onOpenFinancials={() => handleScrollToSection(\'investors\')}\n      />\n\n      {/* Engineering RFQ Modal */}\n      <RfqModal\n        isOpen={isRfqOpen}\n        onClose={() => setIsRfqOpen(false)}\n        initialProduct={selectedRfqProduct}\n      />\n\n      {/* Product Datasheet Modal */}\n      <ProductModal\n        product={selectedModalProduct}\n        onClose={() => setSelectedModalProduct(null)}\n        onOpenRfq={(prod) => {\n          setSelectedModalProduct(null);\n          handleOpenRfq(prod);\n        }}\n      />\n    </div>\n  );\n}\n"
    }
