  file_change {
    absolute_path_uri: "file:///src/components/InvestorPortal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  TrendingUp, \n  FileText, \n  Download, \n  ExternalLink, \n  ArrowRight, \n  DollarSign, \n  CheckCircle2, \n  Calendar, \n  ShieldCheck,\n  Sparkles\n} from \'lucide-react\';\nimport { SANSERA_FINANCIALS } from \'../data/sanseraData\';\nimport { FinancialMetric } from \'../types\';\n\ninterface InvestorPortalProps {\n  onOpenRfq: () => void;\n}\n\nexport const InvestorPortal: React.FC<InvestorPortalProps> = ({ onOpenRfq }) => {\n  const [selectedReport, setSelectedReport] = useState<FinancialMetric>(SANSERA_FINANCIALS[0]);\n\n  return (\n    <section id=\"investors\" className=\"py-24 bg-[#090d16] relative overflow-hidden border-t border-white/5\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/3 right-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase\">\n              <TrendingUp className=\"w-3.5 h-3.5\" />\n              Investor Relations & Financials\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n              Strong Fundamentals.{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400\">\n                Consistent Profitability.\n              </span>\n            </h2>\n            <p className=\"text-base text-slate-400 font-normal\">\n              Listed on NSE & BSE under symbol SANSERA. Delivering high return on capital employed (ROCE) through engineering leadership.\n            </p>\n          </div>\n\n          {/* NSE Ticker Live Pill */}\n          <div className=\"p-4 rounded-2xl bg-gradient-to-br from-slate-900 to-[#0c1220] border border-cyan-500/30 flex items-center gap-4 shadow-xl\">\n            <div>\n              <div className=\"text-[10px] font-mono uppercase text-slate-400 font-bold\">National Stock Exchange</div>\n              <div className=\"text-lg font-extrabold text-white font-mono flex items-center gap-2\">\n                <span>NSE: SANSERA</span>\n                <span className=\"px-2 py-0.5 rounded text-xs bg-emerald-950 text-emerald-400 border border-emerald-500/40\">\n                  +18.4% YoY\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Financial Highlights Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-16\">\n          {SANSERA_FINANCIALS.map((item, idx) => {\n            const isSelected = selectedReport.quarter === item.quarter;\n\n            return (\n              <div\n                key={idx}\n                onClick={() => setSelectedReport(item)}\n                className={`p-6 rounded-3xl border transition-all cursor-pointer flex flex-col justify-between space-y-6 ${\n                  isSelected\n                    ? \'bg-gradient-to-b from-cyan-950 to-slate-900 border-cyan-500 shadow-2xl shadow-cyan-950/60 scale-[1.02]\'\n                    : \'bg-slate-900/70 border-white/5 hover:border-cyan-500/30 text-slate-300\'\n                }`}\n              >\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-800 text-cyan-300 border border-white/5\">\n                      {item.quarter}\n                    </span>\n                    <span className=\"text-xs font-mono text-emerald-400 font-bold\">\n                      {item.growthYoY}\n                    </span>\n                  </div>\n\n                  <h3 className=\"text-xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                    {item.title}\n                  </h3>\n\n                  <div className=\"space-y-1.5 pt-2 font-mono text-xs\">\n                    <div className=\"flex justify-between text-slate-300\">\n                      <span className=\"text-slate-400\">Total Revenue:</span>\n                      <strong className=\"text-white text-sm\">{item.revenue}</strong>\n                    </div>\n                    <div className=\"flex justify-between text-slate-300\">\n                      <span className=\"text-slate-400\">EBITDA:</span>\n                      <strong className=\"text-cyan-300\">{item.ebitda}</strong>\n                    </div>\n                    <div className=\"flex justify-between text-slate-300\">\n                      <span className=\"text-slate-400\">Profit After Tax (PAT):</span>\n                      <strong className=\"text-emerald-400\">{item.pat}</strong>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"pt-3 border-t border-white/10 flex items-center justify-between text-xs text-cyan-400 font-semibold\">\n                  <span className=\"flex items-center gap-1\">\n                    <Calendar className=\"w-3.5 h-3.5\" />\n                    {item.date}\n                  </span>\n                  <span className=\"flex items-center gap-1 group-hover:translate-x-1 transition-transform\">\n                    <Download className=\"w-3.5 h-3.5\" />\n                    Download PDF\n                  </span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Corporate Governance & Investor Downloads Kit */}\n        <div className=\"p-8 rounded-3xl bg-slate-900/90 border border-cyan-500/30 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 shadow-2xl\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <span className=\"px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-mono font-bold border border-cyan-500/40\">\n              Corporate Governance & Disclosures\n            </span>\n            <h3 className=\"text-2xl font-bold text-white\">\n              Institutional Shareholding & Investor Presentations\n            </h3>\n            <p className=\"text-sm text-slate-300\">\n              Access audited financial statements, earnings conference call transcripts, credit rating reports (ICRA / CRISIL AA), and investor presentations.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3 shrink-0\">\n            <a\n              href=\"#download-annual-fy24\"\n              onClick={(e) => {\n                e.preventDefault();\n                alert(\'Downloading Sansera Engineering Limited Annual Audited Report FY2024 (PDF)\');\n              }}\n              className=\"px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs border border-white/10 flex items-center gap-2 transition-all\"\n            >\n              <FileText className=\"w-4 h-4 text-cyan-400\" />\n              <span>Annual Report FY24</span>\n            </a>\n\n            <button\n              onClick={onOpenRfq}\n              className=\"px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-600/30 flex items-center gap-2 transition-all\"\n            >\n              <span>Contact Investor Desk</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
