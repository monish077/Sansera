        }
        lines {
          text: "    const interval = setInterval(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const delta = (Math.random() * 0.4 - 0.15).toFixed(2);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const numericCurrent = 2145.30 + parseFloat(delta);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      setStockPrice(numericCurrent.toLocaleString(\'en-IN\', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const changeNum = parseFloat(delta);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      setIsStockUp(changeNum >= 0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      setStockChange(`${changeNum >= 0 ? \'+\' : \'\'}${(1.42 + changeNum / 10).toFixed(2)}%`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }, 8000);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
