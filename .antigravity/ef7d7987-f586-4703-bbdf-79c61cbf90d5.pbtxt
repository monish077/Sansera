  file_change {
    absolute_path_uri: "file:///src/components/RfqModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  X, \n  UploadCloud, \n  Check, \n  Send, \n  ShieldCheck, \n  FileText, \n  Sparkles, \n  Sliders, \n  Building2, \n  Mail, \n  Phone, \n  Lock,\n  ArrowRight\n} from \'lucide-react\';\nimport { ProductItem, ProductSegmentId } from \'../types\';\n\ninterface RfqModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  initialProduct?: ProductItem | null;\n}\n\nexport const RfqModal: React.FC<RfqModalProps> = ({ isOpen, onClose, initialProduct }) => {\n  const [segment, setSegment] = useState<ProductSegmentId>(initialProduct?.category || \'automotive\');\n  const [componentName, setComponentName] = useState(initialProduct?.name || \'\');\n  const [toleranceGrade, setToleranceGrade] = useState(\'\302\261 1.5 microns (Ultra-Precision)\');\n  const [annualVolume, setAnnualVolume] = useState(\'500,000 to 2,000,000 units/year\');\n  const [material, setMaterial] = useState(initialProduct?.specs.metallurgy || \'Forged Micro-Alloy Steel (38MnS6 / 42CrMo4)\');\n  const [ndaRequired, setNdaRequired] = useState(true);\n  const [clientName, setClientName] = useState(\'\');\n  const [clientEmail, setClientEmail] = useState(\'\');\n  const [companyName, setCompanyName] = useState(\'\');\n  const [notes, setNotes] = useState(\'\');\n  const [submitted, setSubmitted] = useState(false);\n  const [fileUploaded, setFileUploaded] = useState<string | null>(null);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-xl animate-in fade-in duration-200\">\n      <div className=\"relative w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-3xl bg-[#090d16] border border-cyan-500/40 p-6 sm:p-8 shadow-2xl text-slate-200\">\n        \n        {/* Close Button */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-6 right-6 p-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white border border-white/10 transition-colors\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        {submitted ? (\n          <div className=\"py-12 text-center space-y-6\">\n            <div className=\"w-16 h-16 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 mx-auto\">\n              <Check className=\"w-8 h-8\" />\n            </div>\n\n            <div className=\"space-y-2 max-w-md mx-auto\">\n              <h3 className=\"text-2xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                Engineering RFQ Received\n              </h3>\n              <p className=\"text-sm text-slate-300\">\n                Your RFQ for <strong className=\"text-cyan-400\">{componentName || \'Precision Component\'}</strong> has been routed to our Chief Applications Engineer at Sansera Plant 07 Tech Center.\n              </p>\n            </div>\n\n            <div className=\"p-4 rounded-xl bg-slate-900/80 border border-white/10 max-w-md mx-auto text-xs font-mono text-slate-400 space-y-1\">\n              <div>Reference ID: <strong className=\"text-cyan-300\">RFQ-SANSERA-{Math.floor(100000 + Math.random() * 900000)}</strong></div>\n              <div>Estimated Feasibility Response: <strong className=\"text-emerald-400\">Within 24-48 Hours</strong></div>\n              {ndaRequired && <div className=\"text-cyan-400\">Mutual NDA Draft Dispatched</div>}\n            </div>\n\n            <button\n              onClick={() => {\n                setSubmitted(false);\n                onClose();\n              }}\n              className=\"px-8 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs uppercase tracking-wider\"\n            >\n              Done & Return To Portal\n            </button>\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit} className=\"space-y-6\">\n            \n            {/* Header */}\n            <div>\n              <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase\">\n                <Sparkles className=\"w-3.5 h-3.5\" />\n                Engineering Feasibility & Quotation\n              </div>\n              <h3 className=\"text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n                Request Technical Component RFQ\n              </h3>\n              <p className=\"text-xs sm:text-sm text-slate-400 mt-1\">\n                Direct conduit to Sansera tooling engineers, forging metallurgists, and CNC process architects.\n              </p>\n            </div>\n\n            {/* Segment Selector */}\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-mono font-bold text-slate-300 uppercase\">\n                1. Industry & Application Segment\n              </label>\n              <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-2\">\n                {[\n                  { id: \'automotive\', label: \'Automotive ICE/Hybrid\' },\n                  { id: \'aerospace\', label: \'Aerospace AS9100D\' },\n                  { id: \'ev-mobility\', label: \'EV & E-Axle Rotor\' },\n                  { id: \'non-automotive\', label: \'Off-Highway & Agri\' },\n                ].map((s) => (\n                  <button\n                    type=\"button\"\n                    key={s.id}\n                    onClick={() => setSegment(s.id as ProductSegmentId)}\n                    className={`p-2.5 rounded-xl text-xs font-mono font-bold border transition-all text-center ${\n                      segment === s.id\n                        ? \'bg-cyan-500 text-black border-cyan-400 shadow-md\'\n                        : \'bg-slate-900 text-slate-400 border-white/10 hover:text-white\'\n                    }`}\n                  >\n                    {s.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Component Name & Tolerances */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-mono font-bold text-slate-300 uppercase\">\n                  Component / Part Description\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Forged Monoblock Crankshaft, Actuator Bracket\"\n                  value={componentName}\n                  onChange={(e) => setComponentName(e.target.value)}\n                  className=\"w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-mono font-bold text-slate-300 uppercase\">\n                  Target Tolerance Precision\n                </label>\n                <select\n                  value={toleranceGrade}\n                  onChange={(e) => setToleranceGrade(e.target.value)}\n                  className=\"w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                >\n                  <option value=\"\302\261 1.0 micron (Sub-Micron Bearing Journal)\">\302\261 1.0 micron (Sub-Micron Bearing Journal)</option>\n                  <option value=\"\302\261 1.5 microns (Ultra-Precision Powertrain)\">\302\261 1.5 microns (Ultra-Precision Powertrain)</option>\n                  <option value=\"\302\261 2.5 microns (Aerospace Titanium)\">\302\261 2.5 microns (Aerospace Titanium)</option>\n                  <option value=\"\302\261 5.0 microns (Heavy Chassis / Off-Highway)\">\302\261 5.0 microns (Heavy Chassis / Off-Highway)</option>\n                </select>\n              </div>\n            </div>\n\n            {/* Metallurgy & Annual Volume */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-mono font-bold text-slate-300 uppercase\">\n                  Alloy / Metallurgy Specification\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. 42CrMo4, Ti-6Al-4V, C70S6, 20MnCr5\"\n                  value={material}\n                  onChange={(e) => setMaterial(e.target.value)}\n                  className=\"w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1.5\">\n                <label className=\"text-xs font-mono font-bold text-slate-300 uppercase\">\n                  Projected Annual Volume\n                </label>\n                <select\n                  value={annualVolume}\n                  onChange={(e) => setAnnualVolume(e.target.value)}\n                  className=\"w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                >\n                  <option value=\"Prototype / Low Volume (5,000 - 25,000 / yr)\">Prototype / Low Volume (5,000 - 25,000 / yr)</option>\n                  <option value=\"Medium Scale (50,000 - 250,000 / yr)\">Medium Scale (50,000 - 250,000 / yr)</option>\n                  <option value=\"500,000 to 2,000,000 units/year\">High Volume (500,000 to 2,000,000 / yr)</option>\n                  <option value=\"Giga Scale (2,000,000+ units/year)\">Giga Scale (2,000,000+ units/year)</option>\n                </select>\n              </div>\n            </div>\n\n            {/* Drawing File Dropzone */}\n            <div className=\"space-y-1.5\">\n              <label className=\"text-xs font-mono font-bold text-slate-300 uppercase\">\n                CAD / 2D Blueprint Attachment (STEP, IGES, DXF, PDF)\n              </label>\n              <div\n                onClick={() => setFileUploaded(\'Component_Engineering_Blueprint_RevD.step (14.2 MB)\')}\n                className=\"p-4 rounded-2xl border-2 border-dashed border-cyan-500/40 hover:border-cyan-400 bg-slate-900/50 flex items-center justify-center gap-3 cursor-pointer text-center transition-colors\"\n              >\n                <UploadCloud className=\"w-6 h-6 text-cyan-400 shrink-0\" />\n                <div className=\"text-xs\">\n                  {fileUploaded ? (\n                    <span className=\"text-emerald-400 font-mono font-bold flex items-center gap-1\">\n                      <Check className=\"w-3.5 h-3.5\" /> Attached: {fileUploaded}\n                    </span>\n                  ) : (\n                    <span className=\"text-slate-300\">\n                      Click to attach 3D CAD or 2D Drawing (or drag & drop here)\n                    </span>\n                  )}\n                </div>\n              </div>\n            </div>\n\n            {/* Contact Information */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-white/10\">\n              <div className=\"space-y-1\">\n                <label className=\"text-[11px] font-mono text-slate-400\">Engineer / Lead Name *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Dr. Markus Weber\"\n                  value={clientName}\n                  onChange={(e) => setClientName(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"text-[11px] font-mono text-slate-400\">OEM / Tier-1 Company *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Global Auto OEM\"\n                  value={companyName}\n                  onChange={(e) => setCompanyName(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"space-y-1\">\n                <label className=\"text-[11px] font-mono text-slate-400\">Corporate Email *</label>\n                <input\n                  type=\"email\"\n                  required\n                  placeholder=\"name@company.com\"\n                  value={clientEmail}\n                  onChange={(e) => setClientEmail(e.target.value)}\n                  className=\"w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/10 focus:border-cyan-500 text-white text-xs font-mono focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            {/* NDA Toggle & Submit CTA */}\n            <div className=\"pt-2 flex flex-col sm:flex-row items-center justify-between gap-4\">\n              <label className=\"flex items-center gap-2 text-xs font-mono text-slate-300 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={ndaRequired}\n                  onChange={(e) => setNdaRequired(e.target.checked)}\n                  className=\"w-4 h-4 rounded text-cyan-500 focus:ring-0 bg-slate-900 border-white/20\"\n                />\n                <span className=\"flex items-center gap-1\">\n                  <Lock className=\"w-3 h-3 text-cyan-400\" />\n                  Execute Bilateral Non-Disclosure Agreement (NDA)\n                </span>\n              </label>\n\n              <button\n                type=\"submit\"\n                className=\"w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-xl shadow-cyan-600/30 flex items-center justify-center gap-2 transition-all\"\n              >\n                <span>Submit RFQ Package</span>\n                <Send className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n          </form>\n        )}\n\n      </div>\n    </div>\n  );\n};\n"
    }
