  file_change {
    absolute_path_uri: "file:///src/components/CapabilitiesSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Compass, \n  Flame, \n  Cog, \n  Cpu, \n  Layers, \n  ShieldCheck, \n  ArrowRight, \n  CheckCircle2, \n  Activity, \n  Sparkles,\n  Zap,\n  Gauge\n} from \'lucide-react\';\nimport { SANSERA_CAPABILITIES } from \'../data/sanseraData\';\nimport { CapabilityItem } from \'../types\';\n\ninterface CapabilitiesSectionProps {\n  onOpenRfq: () => void;\n}\n\nconst iconMap: Record<string, any> = {\n  Compass,\n  Flame,\n  Cog,\n  Cpu,\n  Layers,\n  ShieldCheck,\n};\n\nexport const CapabilitiesSection: React.FC<CapabilitiesSectionProps> = ({ onOpenRfq }) => {\n  const [activeCapabilityIndex, setActiveCapabilityIndex] = useState(0);\n  const activeCap = SANSERA_CAPABILITIES[activeCapabilityIndex];\n  const IconComponent = iconMap[activeCap.iconName] || Cog;\n\n  return (\n    <section id=\"capabilities\" className=\"py-24 bg-[#07090e] relative overflow-hidden border-t border-white/5\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/3 left-1/4 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n      <div className=\"absolute bottom-10 right-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-cyan-400\"></span>\n              Core Engineering Competencies\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n              Integrated Precision{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400\">\n                Manufacturing Ecosystem\n              </span>\n            </h2>\n            <p className=\"text-base text-slate-400 font-normal\">\n              From finite element computer simulations to heavy 4,000T closed-die forging, sub-micron CNC grinding, and sub-pixel metrology cleanrooms.\n            </p>\n          </div>\n\n          <button\n            onClick={onOpenRfq}\n            className=\"px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-white/10 hover:border-cyan-500/40 text-xs font-bold uppercase tracking-wider transition-all flex items-center gap-2\"\n          >\n            <span>Consult Chief Engineer</span>\n            <ArrowRight className=\"w-4 h-4 text-cyan-400\" />\n          </button>\n        </div>\n\n        {/* Capabilities Grid Switcher & Detailed Showcase */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* Left: 6 Capability Buttons */}\n          <div className=\"lg:col-span-5 space-y-3\">\n            {SANSERA_CAPABILITIES.map((cap, idx) => {\n              const CapIcon = iconMap[cap.iconName] || Cog;\n              const isActive = activeCapabilityIndex === idx;\n\n              return (\n                <button\n                  key={cap.id}\n                  onClick={() => setActiveCapabilityIndex(idx)}\n                  className={`w-full p-4 rounded-2xl text-left transition-all border flex items-center gap-4 group relative overflow-hidden ${\n                    isActive\n                      ? \'bg-gradient-to-r from-cyan-950/90 to-slate-900 border-cyan-500 shadow-xl shadow-cyan-950/50\'\n                      : \'bg-slate-900/60 border-white/5 hover:border-cyan-500/30 text-slate-400 hover:text-white\'\n                  }`}\n                >\n                  <div className={`p-3 rounded-xl font-mono text-xs font-bold shrink-0 transition-colors ${\n                    isActive ? \'bg-cyan-500 text-black shadow-lg shadow-cyan-500/30\' : \'bg-slate-800 text-slate-300 group-hover:bg-slate-700\'\n                  }`}>\n                    {cap.number}\n                  </div>\n\n                  <div className=\"flex-1 min-w-0\">\n                    <div className=\"flex items-center justify-between\">\n                      <div className=\"text-sm font-bold text-white tracking-tight truncate\">\n                        {cap.title}\n                      </div>\n                      <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/80 text-cyan-300 border border-white/5\">\n                        {cap.badge}\n                      </span>\n                    </div>\n                    <div className=\"text-xs text-slate-400 truncate mt-0.5\">\n                      {cap.subtitle}\n                    </div>\n                  </div>\n\n                  {isActive && (\n                    <div className=\"absolute right-0 top-0 bottom-0 w-1 bg-cyan-400\"></div>\n                  )}\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Right: Active Capability Comprehensive Deep-Dive Card */}\n          <div className=\"lg:col-span-7 rounded-3xl bg-gradient-to-b from-slate-900/95 to-[#090d16] border border-cyan-500/30 p-8 shadow-2xl flex flex-col justify-between space-y-8 relative overflow-hidden\">\n            \n            {/* Top Badge & Metric Bar */}\n            <div>\n              <div className=\"flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-white/10\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-3 rounded-xl bg-cyan-500/20 border border-cyan-500/40 text-cyan-300\">\n                    <IconComponent className=\"w-6 h-6\" />\n                  </div>\n                  <div>\n                    <span className=\"text-[11px] font-mono text-cyan-400 uppercase font-bold tracking-wider\">\n                      Capability {activeCap.number} \342\200\242 {activeCap.badge}\n                    </span>\n                    <h3 className=\"text-2xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                      {activeCap.title}\n                    </h3>\n                  </div>\n                </div>\n\n                <div className=\"px-4 py-2 rounded-xl bg-slate-950 border border-cyan-500/30 text-right\">\n                  <span className=\"text-[10px] font-mono text-slate-400 block uppercase\">Capacity Metric</span>\n                  <span className=\"text-sm font-mono font-bold text-cyan-300\">{activeCap.outputMetric}</span>\n                </div>\n              </div>\n\n              {/* Description & Subtitle */}\n              <div className=\"mt-6 space-y-3\">\n                <h4 className=\"text-base font-semibold text-slate-200\">\n                  {activeCap.subtitle}\n                </h4>\n                <p className=\"text-sm text-slate-300 font-light leading-relaxed\">\n                  {activeCap.description}\n                </p>\n              </div>\n\n              {/* Key Technical Features Checklist */}\n              <div className=\"mt-6 space-y-3\">\n                <span className=\"text-xs font-mono font-bold text-slate-400 uppercase tracking-wider block\">\n                  Process & Quality Benchmarks\n                </span>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  {activeCap.keyFeatures.map((feat, idx) => (\n                    <div key={idx} className=\"p-3 rounded-xl bg-black/40 border border-white/5 flex items-start gap-2.5\">\n                      <CheckCircle2 className=\"w-4 h-4 text-cyan-400 shrink-0 mt-0.5\" />\n                      <span className=\"text-xs text-slate-200 leading-snug\">{feat}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* Machinery & Infrastructure Callout */}\n              <div className=\"mt-6 p-4 rounded-xl bg-cyan-950/30 border border-cyan-500/30 flex items-center justify-between gap-4\">\n                <div className=\"space-y-0.5\">\n                  <span className=\"text-[11px] font-mono text-cyan-400 uppercase font-bold\">Standard Tooling & Machinery</span>\n                  <div className=\"text-xs font-mono text-slate-200\">{activeCap.equipment}</div>\n                </div>\n                <div className=\"p-2 rounded-lg bg-cyan-500/20 text-cyan-300\">\n                  <Zap className=\"w-4 h-4\" />\n                </div>\n              </div>\n            </div>\n\n            {/* Bottom Action Strip */}\n            <div className=\"pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4\">\n              <div className=\"text-xs text-slate-400 font-mono\">\n                ISO 9001 / IATF 16949 / AS 9100D Audit Verified\n              </div>\n\n              <button\n                onClick={onOpenRfq}\n                className=\"px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-600/30 flex items-center gap-2 transition-all\"\n              >\n                <span>Request Process Audit</span>\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
