    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Building2, \n  MapPin, \n  ShieldCheck, \n  Users, \n  Layers, \n  Globe, \n  ArrowRight, \n  ExternalLink,\n  ChevronRight,\n  Sparkles,\n  Maximize2\n} from \'lucide-react\';\nimport { SANSERA_FACILITIES } from \'../data/sanseraData\';\nimport { FacilityItem } from \'../types\';\n\ninterface FacilitiesMapProps {\n  onOpenRfq: () => void;\n}\n\nexport const FacilitiesMap: React.FC<FacilitiesMapProps> = ({ onOpenRfq }) => {\n  const [selectedFacility, setSelectedFacility] = useState<FacilityItem>(SANSERA_FACILITIES[0]);\n  const [activeRegion, setActiveRegion] = useState<\'all\' | \'india\' | \'europe\'>(\'all\');\n\n  const filteredFacilities = SANSERA_FACILITIES.filter(f => {\n    if (activeRegion === \'europe\') return f.country.includes(\'Sweden\') || f.country.includes(\'Europe\');\n    if (activeRegion === \'india\') return f.country === \'India\';\n    return true;\n  });\n\n  return (\n    <section id=\"facilities\" className=\"py-24 bg-[#07090e] relative overflow-hidden border-t border-white/5\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/4 right-0 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n      <div className=\"absolute bottom-10 left-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Section Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-cyan-400 uppercase\">\n              <Building2 className=\"w-3.5 h-3.5\" />\n              Global Manufacturing Footprint\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n              17+ Advanced Facilities Across{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400\">\n                India & Europe\n              </span>\n            </h2>\n            <p className=\"text-base text-slate-400 font-normal\">\n              State-of-the-art closed-die forging, 5-axis aerospace machining, and in-house SPM assembly campuses built for Tier-1 supply reliability.\n            </p>\n          </div>\n\n          {/* Region Tabs */}\n          <div className=\"flex items-center gap-2 p-1.5 rounded-xl bg-slate-900 border border-white/10\">\n            <button\n              onClick={() => setActiveRegion(\'all\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all ${\n                activeRegion === \'all\' ? \'bg-cyan-500 text-black shadow-md\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              All Plants (17+)\n            </button>\n            <button\n              onClick={() => setActiveRegion(\'india\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all ${\n                activeRegion === \'india\' ? \'bg-cyan-500 text-black shadow-md\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              India (HQ & Hubs)\n            </button>\n            <button\n              onClick={() => setActiveRegion(\'europe\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-mono font-bold transition-all ${\n                activeRegion === \'europe\' ? \'bg-cyan-500 text-black shadow-md\' : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Europe (Sweden)\n            </button>\n          </div>\n        </div>\n\n        {/* Interactive Layout: Plants List & Interactive Plant Inspector HUD */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch mb-16\">\n          \n          {/* Left Plant Card Selector List */}\n          <div className=\"lg:col-span-5 space-y-3 max-h-[560px] overflow-y-auto pr-1\">\n            {filteredFacilities.map((facility) => {\n              const isSelected = selectedFacility.id === facility.id;\n\n              return (\n                <div\n                  key={facility.id}\n                  onClick={() => setSelectedFacility(facility)}\n                  className={`p-4 rounded-2xl border transition-all cursor-pointer group relative overflow-hidden ${\n                    isSelected\n                      ? \'bg-gradient-to-r from-cyan-950/90 to-slate-900 border-cyan-500 shadow-xl shadow-cyan-950/60 scale-[1.01]\'\n                      : \'bg-slate-900/60 border-white/5 hover:border-cyan-500/30 text-slate-400\'\n                  }`}\n                >\n                  <div className=\"flex items-center justify-between mb-1\">\n                    <span className=\"text-[11px] font-mono font-bold text-cyan-400\">\n                      {facility.plantNo}\n                    </span>\n                    <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-white/5\">\n                      {facility.areaSqMeters}\n                    </span>\n                  </div>\n\n                  <div className=\"text-sm font-bold text-white group-hover:text-cyan-300 transition-colors\">\n                    {facility.name}\n                  </div>\n\n                  <div className=\"text-xs text-slate-400 flex items-center gap-1 mt-1\">\n                    <MapPin className=\"w-3 h-3 text-rose-400 shrink-0\" />\n                    <span>{facility.location}, {facility.state} ({facility.country})</span>\n                  </div>\n\n                  <div className=\"flex flex-wrap gap-1 mt-2.5\">\n                    {facility.specialization.slice(0, 2).map((spec, sIdx) => (\n                      <span key={sIdx} className=\"text-[10px] px-2 py-0.5 rounded bg-black/40 text-slate-300 font-mono\">\n                        {spec}\n                      </span>\n                    ))}\n                  </div>\n\n                  {isSelected && (\n                    <div className=\"absolute right-0 top-0 bottom-0 w-1 bg-cyan-400\"></div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n\n          {/* Right Selected Plant Detailed Telemetry & Specs */}\n          <div className=\"lg:col-span-7 rounded-3xl bg-gradient-to-b from-slate-900/95 to-[#090d16] border border-cyan-500/30 p-8 shadow-2xl flex flex-col justify-between space-y-6\">\n            \n            {/* Top Info */}\n            <div>\n              <div className=\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-white/10\">\n                <div>\n                  <span className=\"text-[11px] font-mono text-cyan-400 uppercase font-bold tracking-wider\">\n                    {selectedFacility.plantNo}\n                  </span>\n                  <h3 className=\"text-2xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                    {selectedFacility.name}\n                  </h3>\n                  <div className=\"text-xs text-slate-400 flex items-center gap-1 mt-0.5 font-mono\">\n                    <MapPin className=\"w-3.5 h-3.5 text-rose-400\" />\n                    <span>{selectedFacility.location}, {selectedFacility.state} \342\200\224 {selectedFacility.country}</span>\n                  </div>\n                </div>\n\n                <div className=\"p-3 rounded-2xl bg-cyan-950/80 border border-cyan-500/40 text-right\">\n                  <div className=\"text-[10px] font-mono text-slate-400 uppercase\">Campus Area</div>\n                  <div className=\"text-lg font-mono font-bold text-cyan-300\">{selectedFacility.areaSqMeters}</div>\n                </div>\n              </div>\n\n              {/* Plant Key Stats Grid */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3 my-6\">\n                <div className=\"p-3.5 rounded-xl bg-black/50 border border-white/5 space-y-1\">\n                  <div className=\"flex items-center gap-1 text-[11px] font-mono text-slate-400\">\n                    <Users className=\"w-3.5 h-3.5 text-cyan-400\" />\n                    <span>Workforce</span>\n                  </div>\n                  <div className=\"text-base font-mono font-bold text-white\">\n                    {selectedFacility.workforceCount}+ Engineers\n                  </div>\n                </div>\n\n                <div className=\"p-3.5 rounded-xl bg-black/50 border border-white/5 space-y-1\">\n                  <div className=\"flex items-center gap-1 text-[11px] font-mono text-slate-400\">\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-400\" />\n                    <span>Certifications</span>\n                  </div>\n                  <div className=\"text-xs font-mono font-bold text-emerald-300 truncate\">\n                    {selectedFacility.certifications[0]}\n                  </div>\n                </div>\n\n                <div className=\"p-3.5 rounded-xl bg-black/50 border border-white/5 space-y-1 col-span-2 sm:col-span-1\">\n                  <div className=\"flex items-center gap-1 text-[11px] font-mono text-slate-400\">\n                    <Globe className=\"w-3.5 h-3.5 text-blue-400\" />\n                    <span>Supply Region</span>\n                  </div>\n                  <div className=\"text-xs font-mono font-bold text-cyan-300\">\n                    Tier-1 Global\n                  </div>\n                </div>\n              </div>\n\n              {/* Specializations */}\n              <div className=\"space-y-2 mb-4\">\n                <span className=\"text-xs font-mono font-bold text-slate-400 uppercase tracking-wider block\">\n                  Campus Capabilities & Specialized Cells\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  {selectedFacility.specialization.map((spec, idx) => (\n                    <span \n                      key={idx} \n                      className=\"px-3 py-1 rounded-lg bg-cyan-950/60 border border-cyan-500/30 text-xs font-mono text-cyan-200\"\n                    >\n                      {spec}\n                    </span>\n                  ))}\n                </div>\n              </div>\n\n              {/* Key Tooling & Machinery */}\n              <div className=\"p-4 rounded-xl bg-slate-900 border border-white/10 space-y-1\">\n                <span className=\"text-[11px] font-mono text-slate-400 uppercase font-bold block\">\n                  Key Machinery & Infrastructure\n                </span>\n                <p className=\"text-xs text-slate-200 font-mono\">\n                  {selectedFacility.keyMachinery}\n                </p>\n              </div>\n\n              {/* Certifications badges */}\n              <div className=\"flex flex-wrap gap-2 mt-4\">\n                {selectedFacility.certifications.map((cert, cIdx) => (\n                  <span key={cIdx} className=\"px-2.5 py-1 rounded bg-slate-800 text-[11px] font-mono text-slate-300 border border-white/5 flex items-center gap-1\">\n                    <ShieldCheck className=\"w-3 h-3 text-cyan-400\" />\n                    {cert}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            {/* Bottom Actions */}\n            <div className=\"pt-4 border-t border-white/10 flex items-center justify-between gap-4\">\n              <div className=\"text-xs text-slate-400 font-mono\">\n                Lat: {selectedFacility.lat.toFixed(4)}\302\260 N, Lng: {selectedFacility.lng.toFixed(4)}\302\260 E\n              </div>\n\n              <button\n                onClick={onOpenRfq}\n                className=\"px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-600/30 flex items-center gap-2 transition-all\"\n              >\n                <span>Schedule Plant Audit</span>\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
