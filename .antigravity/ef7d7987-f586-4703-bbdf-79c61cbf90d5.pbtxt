  file_change {
    absolute_path_uri: "file:///src/components/AutomationSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Cpu, \n  Bot, \n  Activity, \n  Zap, \n  ArrowRight, \n  CheckCircle2, \n  Sparkles, \n  Layers, \n  Gauge, \n  TrendingDown,\n  RotateCw,\n  Sliders\n} from \'lucide-react\';\n\ninterface AutomationSectionProps {\n  onOpenRfq: () => void;\n}\n\nexport const AutomationSection: React.FC<AutomationSectionProps> = ({ onOpenRfq }) => {\n  const [cycleTimeSansera, setCycleTimeSansera] = useState(24.5);\n  const [cycleTimeTraditional, setCycleTimeTraditional] = useState(41.0);\n  const [selectedRobotCell, setSelectedRobotCell] = useState(1);\n  const [simulatedLoad, setSimulatedLoad] = useState(88.4);\n\n  // Live telemetry pulse\n  useEffect(() => {\n    const interval = setInterval(() => {\n      setSimulatedLoad(prev => parseFloat((87.5 + Math.random() * 2.5).toFixed(1)));\n    }, 2000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <section id=\"in-house-building\" className=\"py-24 bg-[#090d16] relative overflow-hidden border-t border-white/5\">\n      {/* Background neon grid effect */}\n      <div \n        className=\"absolute inset-0 opacity-10 pointer-events-none\" \n        style={{\n          backgroundImage: `linear-gradient(to right, #00b4d8 1px, transparent 1px), linear-gradient(to bottom, #00b4d8 1px, transparent 1px)`,\n          backgroundSize: \'48px 48px\'\n        }}\n      />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16 space-y-4\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/80 border border-cyan-500/30 text-xs font-mono font-bold tracking-widest text-cyan-300 uppercase\">\n            <Cpu className=\"w-3.5 h-3.5 text-cyan-400\" />\n            Proprietary Manufacturing Technology\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n            In-House Machine Building &{\' \'}\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400\">\n              Robotic Automation\n            </span>\n          </h2>\n          <p className=\"text-base sm:text-lg text-slate-300 font-normal\">\n            Unlike traditional manufacturers who rely on off-the-shelf machinery, Sansera conceptualizes, designs, fabricates, and programs its own Special Purpose Machines (SPMs) and robotic cells in-house.\n          </p>\n        </div>\n\n        {/* 3 Value Highlights Strip */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n          \n          <div className=\"p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-[#070a12] border border-cyan-500/30 shadow-xl space-y-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-300\">\n              <TrendingDown className=\"w-6 h-6\" />\n            </div>\n            <div className=\"text-3xl font-extrabold text-white font-mono\">40% Savings</div>\n            <div className=\"text-sm font-bold text-cyan-300\">CapEx & Cycle Time Optimization</div>\n            <p className=\"text-xs text-slate-400 leading-relaxed\">\n              Custom multi-spindle fixtures and gantry loaders slash cycle times and eliminate expensive external equipment lead times.\n            </p>\n          </div>\n\n          <div className=\"p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-[#070a12] border border-cyan-500/30 shadow-xl space-y-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-blue-500/20 border border-blue-500/40 flex items-center justify-center text-blue-300\">\n              <Bot className=\"w-6 h-6\" />\n            </div>\n            <div className=\"text-3xl font-extrabold text-white font-mono\">400+ Robots</div>\n            <div className=\"text-sm font-bold text-blue-300\">6-Axis Articulated Automation</div>\n            <p className=\"text-xs text-slate-400 leading-relaxed\">\n              Automated bin-picking, vision-guided deburring, and robotic transfer ensuring 24/7 dark factory repeatability.\n            </p>\n          </div>\n\n          <div className=\"p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-[#070a12] border border-cyan-500/30 shadow-xl space-y-3\">\n            <div className=\"w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-300\">\n              <Activity className=\"w-6 h-6\" />\n            </div>\n            <div className=\"text-3xl font-extrabold text-white font-mono\">Sub-Pixel AOI</div>\n            <div className=\"text-sm font-bold text-emerald-300\">Machine Vision Inspection</div>\n            <p className=\"text-xs text-slate-400 leading-relaxed\">\n              100% inline automated optical inspection for crack, burr, and dimensional verification at line speed.\n            </p>\n          </div>\n\n        </div>\n\n        {/* Interactive Industry 4.0 Telemetry Simulator */}\n        <div className=\"rounded-3xl bg-slate-900/90 border border-cyan-500/40 p-8 shadow-2xl space-y-8\">\n          \n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-6\">\n            <div>\n              <div className=\"text-xs font-mono font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n                In-House SPM Cell #04 \342\200\242 Live Digital Twin\n              </div>\n              <h3 className=\"text-2xl font-bold text-white font-[\'Space_Grotesk\',sans-serif]\">\n                Fracture-Split Con-Rod High-Speed Automated Line\n              </h3>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-xs font-mono px-3 py-1 rounded-full bg-slate-800 text-slate-300 border border-white/10\">\n                SCADA OEE: <strong className=\"text-emerald-400\">{simulatedLoad}%</strong>\n              </span>\n              <button\n                onClick={onOpenRfq}\n                className=\"px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs uppercase tracking-wider transition-all\"\n              >\n                Inquire SPM Line\n              </button>\n            </div>\n          </div>\n\n          {/* Interactive Cycle Time Comparison */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n            \n            {/* Left: Cycle comparison sliders & metrics */}\n            <div className=\"lg:col-span-6 space-y-6\">\n              <h4 className=\"text-sm font-mono uppercase font-bold text-slate-300 tracking-wider\">\n                Cycle Time Comparison (Seconds / Part)\n              </h4>\n\n              {/* Sansera Proprietary SPM Line */}\n              <div className=\"p-4 rounded-xl bg-cyan-950/40 border border-cyan-500/40 space-y-2\">\n                <div className=\"flex items-center justify-between text-xs font-mono\">\n                  <span className=\"text-cyan-300 font-bold flex items-center gap-1.5\">\n                    <Sparkles className=\"w-3.5 h-3.5 text-cyan-400\" />\n                    Sansera In-House SPM Line\n                  </span>\n                  <span className=\"text-cyan-400 font-bold text-sm\">{cycleTimeSansera}s</span>\n                </div>\n                <div className=\"w-full bg-slate-800 rounded-full h-3 overflow-hidden p-0.5\">\n                  <div \n                    className=\"bg-gradient-to-r from-cyan-400 to-blue-500 h-full rounded-full transition-all duration-500\" \n                    style={{ width: `${(cycleTimeSansera / 60) * 100}%` }}\n                  />\n                </div>\n                <div className=\"text-[11px] text-slate-400\">\n                  Twin-spindle gun drilling + laser notch fracture split in single clamping.\n                </div>\n              </div>\n\n              {/* Traditional Standard CNC Machine */}\n              <div className=\"p-4 rounded-xl bg-slate-800/40 border border-white/5 space-y-2\">\n                <div className=\"flex items-center justify-between text-xs font-mono\">\n                  <span className=\"text-slate-300\">Standard Off-The-Shelf Setup</span>\n                  <span className=\"text-slate-400 font-bold text-sm\">{cycleTimeTraditional}s</span>\n                </div>\n                <div className=\"w-full bg-slate-800 rounded-full h-3 overflow-hidden p-0.5\">\n                  <div \n                    className=\"bg-slate-600 h-full rounded-full transition-all duration-500\" \n                    style={{ width: `${(cycleTimeTraditional / 60) * 100}%` }}\n                  />\n                </div>\n                <div className=\"text-[11px] text-slate-500\">\n                  Multiple manual transfers between broaching, boring, and parting operations.\n                </div>\n              </div>\n\n              <div className=\"flex items-center gap-4 text-xs font-mono text-cyan-400\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-400 shrink-0\" />\n                <span>Result: 40.2% faster output, zero part-to-part handling damage.</span>\n              </div>\n            </div>\n\n            {/* Right: Real-time cell visual architecture */}\n            <div className=\"lg:col-span-6 p-6 rounded-2xl bg-[#070a12] border border-white/10 space-y-4\">\n              <div className=\"flex items-center justify-between text-xs font-mono text-slate-400 border-b border-white/10 pb-2\">\n                <span>Integrated Robotic Cell Architecture</span>\n                <span className=\"text-cyan-400\">Zero Unplanned Downtime</span>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3 text-xs\">\n                <div className=\"p-3 rounded-xl bg-slate-900 border border-white/5 space-y-1\">\n                  <span className=\"text-[10px] font-mono text-slate-500 block\">Robotic Arm</span>\n                  <div className=\"font-bold text-white\">FANUC M-20iD / 6-Axis</div>\n                  <div className=\"text-[11px] text-cyan-300 font-mono\">0.02mm Repeatability</div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-900 border border-white/5 space-y-1\">\n                  <span className=\"text-[10px] font-mono text-slate-500 block\">Machine Vision</span>\n                  <div className=\"font-bold text-white\">Cognex In-Sight 8000</div>\n                  <div className=\"text-[11px] text-emerald-300 font-mono\">5MP Sub-Pixel Grading</div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-900 border border-white/5 space-y-1\">\n                  <span className=\"text-[10px] font-mono text-slate-500 block\">PLC & SCADA</span>\n                  <div className=\"font-bold text-white\">Siemens S7-1500 / TIA</div>\n                  <div className=\"text-[11px] text-blue-300 font-mono\">OPC-UA Cloud Telemetry</div>\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-900 border border-white/5 space-y-1\">\n                  <span className=\"text-[10px] font-mono text-slate-500 block\">Automatic Gaging</span>\n                  <div className=\"font-bold text-white\">Marposs In-Process</div>\n                  <div className=\"text-[11px] text-amber-300 font-mono\">Auto Tool Wear Offset</div>\n                </div>\n              </div>\n\n              <div className=\"pt-2 text-center\">\n                <span className=\"text-[11px] font-mono text-slate-400\">\n                  Proprietary technology developed in-house at Sansera Plant 07 Tech Center.\n                </span>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
