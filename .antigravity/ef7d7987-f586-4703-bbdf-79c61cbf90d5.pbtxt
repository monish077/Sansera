        }
        lines {
          text: "        for (let j = 0; j < 4; j++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const lAngle = (j * Math.PI) / 2 + rad * 0.5;"
