          text: "    subtitle: \'Proprietary Automation Giving Unfair Cost & Agility Advantage\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    description: \'Sansera is one of the few global engineering giants that conceptualizes, designs, fabricates, and programs its own Special Purpose Machines (SPMs), automated transfer lines, and 6-axis robotic cells in-house. This gives us total control over cycle times, capital expenditure, and maintenance speed.\',"
