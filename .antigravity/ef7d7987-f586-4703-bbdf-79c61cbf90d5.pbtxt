  file_change {
    absolute_path_uri: "file:///src/components/Footer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { SanseraLogo } from \'./SanseraLogo\';\nimport { \n  Building2, \n  MapPin, \n  Phone, \n  Mail, \n  Globe, \n  ShieldCheck, \n  ArrowUp, \n  TrendingUp,\n  FileText,\n  Sparkles\n} from \'lucide-react\';\n\ninterface FooterProps {\n  onOpenRfq: () => void;\n  onOpenFinancials: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ onOpenRfq, onOpenFinancials }) => {\n  const scrollToTop = () => {\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <footer id=\"contact\" className=\"bg-[#05070c] border-t border-white/10 text-slate-400 text-xs relative overflow-hidden\">\n      \n      {/* Top Banner / Corporate Helpline */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-white/5\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n          \n          <div className=\"lg:col-span-6 space-y-2\">\n            <div className=\"flex items-center gap-3\">\n              <SanseraLogo size=\"md\" variant=\"dark\" />\n            </div>\n            <p className=\"text-slate-300 text-sm max-w-lg font-light leading-relaxed\">\n              Sansera Engineering Limited is an engineering-led manufacturer of complex, high-precision forged and CNC-machined components supplying automotive and aerospace OEMs globally.\n            </p>\n          </div>\n\n          <div className=\"lg:col-span-6 flex flex-wrap items-center lg:justify-end gap-4\">\n            <div className=\"p-4 rounded-2xl bg-slate-900 border border-white/10 space-y-0.5\">\n              <div className=\"text-[10px] font-mono uppercase text-slate-400\">Toll-Free Global Desk</div>\n              <div className=\"text-sm font-bold text-white font-mono flex items-center gap-1.5\">\n                <Phone className=\"w-3.5 h-3.5 text-cyan-400\" />\n                1800-2121-321 / +91 (80) 6784-8100\n              </div>\n            </div>\n\n            <button\n              onClick={onOpenRfq}\n              className=\"px-6 py-3.5 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-600/30 transition-all\"\n            >\n              Request Engineering RFQ\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Main 4-Column Directory */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10\">\n          \n          {/* Col 1: Corporate HQ */}\n          <div className=\"space-y-3\">\n            <div className=\"font-bold text-white uppercase font-mono tracking-wider text-xs\">\n              Corporate Headquarters\n            </div>\n            <div className=\"space-y-1.5 text-slate-300\">\n              <div className=\"font-semibold text-white\">Sansera Engineering Limited</div>\n              <div>Plant 07, 143/A, Bommasandra Industrial Area,</div>\n              <div>Anekal Taluk, Bengaluru \342\200\223 560 099,</div>\n              <div>Karnataka, India.</div>\n              <div className=\"pt-2 text-cyan-400 font-mono\">CIN: L34103KA1981PLC013042</div>\n            </div>\n          </div>\n\n          {/* Col 2: Product Portfolios */}\n          <div className=\"space-y-3\">\n            <div className=\"font-bold text-white uppercase font-mono tracking-wider text-xs\">\n              Product Segments\n            </div>\n            <ul className=\"space-y-2 text-slate-300\">\n              <li><a href=\"#segments\" className=\"hover:text-cyan-400 transition-colors\">Precision Crankshaft Assemblies</a></li>\n              <li><a href=\"#segments\" className=\"hover:text-cyan-400 transition-colors\">Fracture-Split Connecting Rods</a></li>\n              <li><a href=\"#segments\" className=\"hover:text-cyan-400 transition-colors\">Roller Rocker Arms & Valvetrain</a></li>\n              <li><a href=\"#segments\" className=\"hover:text-cyan-400 transition-colors\">Aerospace Flight Control Actuators</a></li>\n              <li><a href=\"#segments\" className=\"hover:text-cyan-400 transition-colors\">EV Hollow High-RPM Rotor Shafts</a></li>\n              <li><a href=\"#segments\" className=\"hover:text-cyan-400 transition-colors\">Chassis Steering Knuckles & Forgings</a></li>\n            </ul>\n          </div>\n\n          {/* Col 3: Engineering & Tech */}\n          <div className=\"space-y-3\">\n            <div className=\"font-bold text-white uppercase font-mono tracking-wider text-xs\">\n              Capabilities & Operations\n            </div>\n            <ul className=\"space-y-2 text-slate-300\">\n              <li><a href=\"#capabilities\" className=\"hover:text-cyan-400 transition-colors\">Closed-Die Forging (4,000T Presses)</a></li>\n              <li><a href=\"#capabilities\" className=\"hover:text-cyan-400 transition-colors\">5-Axis High-Speed CNC Machining</a></li>\n              <li><a href=\"#in-house-building\" className=\"hover:text-cyan-400 transition-colors\">Proprietary In-House SPM Building</a></li>\n              <li><a href=\"#capabilities\" className=\"hover:text-cyan-400 transition-colors\">Controlled Atmosphere Heat Treatment</a></li>\n              <li><a href=\"#facilities\" className=\"hover:text-cyan-400 transition-colors\">17+ Global Manufacturing Plants</a></li>\n              <li><a href=\"#sustainability\" className=\"hover:text-cyan-400 transition-colors\">Zero Liquid Discharge & Solar Power</a></li>\n            </ul>\n          </div>\n\n          {/* Col 4: Investors & Compliance */}\n          <div className=\"space-y-3\">\n            <div className=\"font-bold text-white uppercase font-mono tracking-wider text-xs\">\n              Investors & Governance\n            </div>\n            <ul className=\"space-y-2 text-slate-300\">\n              <li>\n                <button onClick={onOpenFinancials} className=\"hover:text-cyan-400 transition-colors text-left flex items-center gap-1\">\n                  <span>NSE: SANSERA (\342\202\2712,145.30)</span>\n                  <TrendingUp className=\"w-3 h-3 text-emerald-400\" />\n                </button>\n              </li>\n              <li><a href=\"#investors\" className=\"hover:text-cyan-400 transition-colors\">Audited Financial Results (Q4 FY24)</a></li>\n              <li><a href=\"#investors\" className=\"hover:text-cyan-400 transition-colors\">Annual Reports & AGM Notices</a></li>\n              <li><a href=\"#oem-partners\" className=\"hover:text-cyan-400 transition-colors\">Global OEM Client Case Studies</a></li>\n              <li><a href=\"#sustainability\" className=\"hover:text-cyan-400 transition-colors\">ESG Disclosures & Sustainability</a></li>\n              <li><a href=\"#contact\" className=\"hover:text-cyan-400 transition-colors\">Careers & Engineering Trainee Program</a></li>\n            </ul>\n          </div>\n\n        </div>\n      </div>\n\n      {/* Bottom Micro Bar */}\n      <div className=\"border-t border-white/5 py-6 bg-[#040609]\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div className=\"text-slate-400 text-[11px] font-mono\">\n            \302\251 {new Date().getFullYear()} Sansera Engineering Limited. All Rights Reserved. Built to IATF 16949 & AS 9100D Precision Standards.\n          </div>\n\n          <div className=\"flex items-center gap-4 text-[11px]\">\n            <a href=\"#privacy\" className=\"hover:text-cyan-400\">Privacy Policy</a>\n            <span>\342\200\242</span>\n            <a href=\"#terms\" className=\"hover:text-cyan-400\">Terms of Supply</a>\n            <span>\342\200\242</span>\n            <a href=\"#disclaimer\" className=\"hover:text-cyan-400\">Statutory Disclosures</a>\n            <span>\342\200\242</span>\n            <button\n              onClick={scrollToTop}\n              className=\"p-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-cyan-400 transition-colors\"\n              title=\"Back to Top\"\n            >\n              <ArrowUp className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n    </footer>\n  );\n};\n"
    }
