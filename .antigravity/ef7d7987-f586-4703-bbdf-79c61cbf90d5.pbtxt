  file_change {
    absolute_path_uri: "file:///src/components/SustainabilitySection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Sun, \n  Droplets, \n  Recycle, \n  Feather, \n  ArrowRight, \n  Sparkles, \n  ShieldCheck, \n  CheckCircle2,\n  TreePine\n} from \'lucide-react\';\nimport { SANSERA_ESG_METRICS } from \'../data/sanseraData\';\n\nconst iconMap: Record<string, any> = {\n  Sun,\n  Droplets,\n  Recycle,\n  Feather,\n};\n\ninterface SustainabilitySectionProps {\n  onOpenRfq: () => void;\n}\n\nexport const SustainabilitySection: React.FC<SustainabilitySectionProps> = ({ onOpenRfq }) => {\n  return (\n    <section id=\"sustainability\" className=\"py-24 bg-[#07090e] relative overflow-hidden border-t border-white/5\">\n      {/* Background ambient lighting */}\n      <div className=\"absolute top-1/2 left-1/3 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Header */}\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold tracking-widest text-emerald-400 uppercase\">\n              <TreePine className=\"w-3.5 h-3.5\" />\n              ESG & Sustainable Manufacturing\n            </div>\n            <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n              Engineering A{\' \'}\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400\">\n                Low-Carbon Clean Future\n              </span>\n            </h2>\n            <p className=\"text-base text-slate-400 font-normal\">\n              Committed to responsible stewardship through on-site solar generation, 100% Zero Liquid Discharge, steel circularity, and powertrain lightweighting.\n            </p>\n          </div>\n\n          <div className=\"p-3.5 rounded-2xl bg-emerald-950/40 border border-emerald-500/30 flex items-center gap-3\">\n            <ShieldCheck className=\"w-6 h-6 text-emerald-400\" />\n            <div className=\"text-xs\">\n              <div className=\"font-bold text-white\">ISO 14001:2015 & ISO 50001</div>\n              <div className=\"text-emerald-300 font-mono\">100% Green Audited Plants</div>\n            </div>\n          </div>\n        </div>\n\n        {/* 4 ESG Cards */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16\">\n          {SANSERA_ESG_METRICS.map((esg, idx) => {\n            const Icon = iconMap[esg.icon] || Sun;\n\n            return (\n              <div\n                key={idx}\n                className=\"p-6 rounded-3xl bg-gradient-to-b from-slate-900/90 to-[#070a12] border border-emerald-500/20 hover:border-emerald-500/50 shadow-xl transition-all flex flex-col justify-between space-y-6 group\"\n              >\n                <div className=\"space-y-4\">\n                  <div className=\"w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-300 group-hover:scale-110 transition-transform\">\n                    <Icon className=\"w-6 h-6\" />\n                  </div>\n\n                  <div>\n                    <div className=\"text-3xl font-extrabold text-white font-mono flex items-baseline gap-1\">\n                      <span>{esg.value}</span>\n                      <span className=\"text-sm font-normal text-emerald-400\">{esg.unit}</span>\n                    </div>\n                    <div className=\"text-base font-bold text-slate-100 mt-1 font-[\'Space_Grotesk\',sans-serif]\">\n                      {esg.metric}\n                    </div>\n                  </div>\n\n                  <p className=\"text-xs text-slate-400 leading-relaxed\">\n                    {esg.description}\n                  </p>\n                </div>\n\n                <div className=\"pt-3 border-t border-white/5\">\n                  <div className=\"text-[11px] font-mono font-bold text-emerald-400\">\n                    Target: {esg.target}\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Highlight Banner on Lightweighting & EV Drivetrain */}\n        <div className=\"p-8 rounded-3xl bg-gradient-to-r from-emerald-950/40 via-slate-900 to-cyan-950/40 border border-emerald-500/30 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl\">\n          <div className=\"space-y-2 max-w-2xl\">\n            <span className=\"px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold border border-emerald-500/40\">\n              Circularity & Decarbonization\n            </span>\n            <h3 className=\"text-2xl font-bold text-white\">\n              Accelerating Global OEM Decarbonization Goals\n            </h3>\n            <p className=\"text-sm text-slate-300\">\n              By engineering hollow rotor shafts, lightweight fracture-split con-rods, and aluminium forged links, we help OEM fleets eliminate tens of thousands of metric tonnes of lifecycle emissions.\n            </p>\n          </div>\n\n          <button\n            onClick={onOpenRfq}\n            className=\"shrink-0 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-black font-bold text-xs uppercase tracking-wider shadow-lg shadow-emerald-500/25 flex items-center gap-2 transition-all\"\n          >\n            <span>Request ESG Report</span>\n            <ArrowRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
