        }
        lines {
          text: "  const [isAutoRotating, setIsAutoRotating] = useState(true);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const canvasRef = useRef<HTMLCanvasElement | null>(null);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const categories: { id: ProductSegmentId; label: string; icon: any; count: number; badge: string }[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'automotive\', label: \'Automotive\', icon: Car, count: 3, badge: \'ICE & Hybrid\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'aerospace\', label: \'Aerospace\', icon: Plane, count: 1, badge: \'AS9100D Certified\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'non-automotive\', label: \'Non-Automotive\', icon: Tractor, count: 1, badge: \'Agri & Industrial\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'ev-mobility\', label: \'EV & Clean Mobility\', icon: Zap, count: 1, badge: \'Next-Gen E-Axle\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const filteredProducts = SANSERA_PRODUCTS.filter(p => p.category === activeCategory);"
