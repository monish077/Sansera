  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { SanseraLogo } from \'./SanseraLogo\';\nimport { \n  TrendingUp, \n  Menu, \n  X, \n  ChevronDown, \n  ArrowRight, \n  ShieldCheck, \n  FileText, \n  Cpu, \n  Factory, \n  Globe, \n  Layers, \n  PhoneCall,\n  Sparkles,\n  Plane,\n  Car,\n  Tractor,\n  Zap\n} from \'lucide-react\';\n\ninterface NavbarProps {\n  onOpenRfq: () => void;\n  onOpenFinancials: () => void;\n  onSelectSegment?: (segmentId: string) => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onOpenRfq, onOpenFinancials, onSelectSegment }) => {\n  const [scrolled, setScrolled] = useState(false);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [activeDropdown, setActiveDropdown] = useState<string | null>(null);\n  const [stockPrice, setStockPrice] = useState(\'2,145.30\');\n  const [stockChange, setStockChange] = useState(\'+1.42%\');\n  const [isStockUp, setIsStockUp] = useState(true);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      if (window.scrollY > 20) {\n        setScrolled(true);\n      } else {\n        setScrolled(false);\n      }\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  // Subtle live stock price fluctuation effect\n  useEffect(() => {\n    const interval = setInterval(() => {\n      const delta = (Math.random() * 0.4 - 0.15).toFixed(2);\n      const numericCurrent = 2145.30 + parseFloat(delta);\n      setStockPrice(numericCurrent.toLocaleString(\'en-IN\', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));\n      const changeNum = parseFloat(delta);\n      setIsStockUp(changeNum >= 0);\n      setStockChange(`${changeNum >= 0 ? \'+\' : \'\'}${(1.42 + changeNum / 10).toFixed(2)}%`);\n    }, 8000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <header\n      className={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${\n        scrolled\n          ? \'bg-[#07090e]/90 backdrop-blur-xl border-b border-white/10 shadow-2xl shadow-black/50 py-3\'\n          : \'bg-gradient-to-b from-[#07090e]/95 via-[#07090e]/70 to-transparent py-5\'\n      }`}\n    >\n      {/* Top micro-bar for global stock ticker & quick links */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-2 flex items-center justify-between text-xs text-slate-400 border-b border-white/5 pb-2\">\n        <div className=\"flex items-center gap-4\">\n          <button\n            onClick={onOpenFinancials}\n            className=\"flex items-center gap-2 group hover:text-cyan-400 transition-colors\"\n          >\n            <span className=\"font-mono font-semibold text-slate-300\">NSE: SANSERA</span>\n            <span className=\"font-mono text-white font-bold\">\342\202\271{stockPrice}</span>\n            <span className={`inline-flex items-center gap-0.5 font-mono px-1.5 py-0.5 rounded text-[10px] font-bold ${\n              isStockUp ? \'bg-emerald-950/80 text-emerald-400 border border-emerald-800/50\' : \'bg-rose-950/80 text-rose-400 border border-rose-800/50\'\n            }`}>\n              <TrendingUp className=\"w-3 h-3\" />\n              {stockChange}\n            </span>\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\"></span>\n          </button>\n          \n          <span className=\"hidden md:inline text-slate-600\">|</span>\n          \n          <div className=\"hidden md:flex items-center gap-3 text-[11px] text-slate-400\">\n            <span className=\"flex items-center gap-1\"><ShieldCheck className=\"w-3.5 h-3.5 text-cyan-400\" /> IATF 16949 & AS 9100D</span>\n            <span>\342\200\242</span>\n            <span>17+ Global Facilities</span>\n          </div>\n        </div>\n\n        <div className=\"flex items-center gap-4 text-[11px]\">\n          <a href=\"#investors\" className=\"hover:text-cyan-400 transition-colors\">Investors</a>\n          <a href=\"#sustainability\" className=\"hover:text-cyan-400 transition-colors\">Sustainability</a>\n          <a href=\"#careers\" className=\"hover:text-cyan-400 transition-colors hidden sm:inline\">Careers</a>\n          <a href=\"#contact\" className=\"hover:text-cyan-400 transition-colors\">Contact</a>\n          <button \n            onClick={onOpenRfq}\n            className=\"text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1\"\n          >\n            <PhoneCall className=\"w-3 h-3\" />\n            1800-2121-321\n          </button>\n        </div>\n      </div>\n\n      {/* Main Navbar */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between\">\n          {/* Brand Logo */}\n          <a href=\"#\" className=\"flex items-center gap-3 group focus:outline-none\">\n            <div className=\"p-1 rounded-lg bg-slate-900/50 border border-white/10 group-hover:border-cyan-500/40 transition-colors\">\n              <SanseraLogo size=\"md\" variant=\"dark\" />\n            </div>\n          </a>\n\n          {/* Desktop Navigation Links */}\n          <nav className=\"hidden lg:flex items-center gap-7\">\n            {/* Products & Segments Dropdown */}\n            <div \n              className=\"relative\"\n              onMouseEnter={() => setActiveDropdown(\'segments\')}\n              onMouseLeave={() => setActiveDropdown(null)}\n            >\n              <a\n                href=\"#segments\"\n                className=\"flex items-center gap-1.5 text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors py-2\"\n              >\n                <span>Product Segments</span>\n                <ChevronDown className={`w-3.5 h-3.5 transition-transform duration-200 ${activeDropdown === \'segments\' ? \'rotate-180 text-cyan-400\' : \'text-slate-400\'}`} />\n              </a>\n\n              {/* Mega menu preview */}\n              {activeDropdown === \'segments\' && (\n                <div className=\"absolute top-full left-0 w-96 p-4 rounded-xl bg-[#0c101a] border border-cyan-500/20 shadow-2xl shadow-black/80 backdrop-blur-2xl transition-all\">\n                  <div className=\"grid grid-cols-2 gap-2 text-xs\">\n                    <a \n                      href=\"#segments\" \n                      onClick={() => onSelectSegment?.(\'automotive\')}\n                      className=\"p-3 rounded-lg bg-slate-900/70 hover:bg-cyan-950/40 border border-white/5 hover:border-cyan-500/30 transition-all flex flex-col gap-1 text-left group\"\n                    >\n                      <div className=\"flex items-center gap-2 text-cyan-400 font-semibold\">\n                        <Car className=\"w-4 h-4\" />\n                        <span>Automotive ICE & Hybrid</span>\n                      </div>\n                      <span className=\"text-[11px] text-slate-400\">Crankshafts, Con-Rods, Rocker Arms</span>\n                    </a>\n\n                    <a \n                      href=\"#segments\" \n                      onClick={() => onSelectSegment?.(\'aerospace\')}\n                      className=\"p-3 rounded-lg bg-slate-900/70 hover:bg-cyan-950/40 border border-white/5 hover:border-cyan-500/30 transition-all flex flex-col gap-1 text-left group\"\n                    >\n                      <div className=\"flex items-center gap-2 text-blue-400 font-semibold\">\n                        <Plane className=\"w-4 h-4\" />\n                        <span>Aerospace & Defense</span>\n                      </div>\n                      <span className=\"text-[11px] text-slate-400\">AS9100D Actuator Brackets & Titanium</span>\n                    </a>\n\n                    <a \n                      href=\"#segments\" \n                      onClick={() => onSelectSegment?.(\'non-automotive\')}\n                      className=\"p-3 rounded-lg bg-slate-900/70 hover:bg-cyan-950/40 border border-white/5 hover:border-cyan-500/30 transition-all flex flex-col gap-1 text-left group\"\n                    >\n                      <div className=\"flex items-center gap-2 text-amber-400 font-semibold\">\n                        <Tractor className=\"w-4 h-4\" />\n                        <span>Off-Highway & Agri</span>\n                      </div>\n                      <span className=\"text-[11px] text-slate-400\">Heavy Forgings & Earthmover Hubs</span>\n                    </a>\n\n                    <a \n                      href=\"#segments\" \n                      onClick={() => onSelectSegment?.(\'ev-mobility\')}\n                      className=\"p-3 rounded-lg bg-slate-900/70 hover:bg-cyan-950/40 border border-white/5 hover:border-cyan-500/30 transition-all flex flex-col gap-1 text-left group\"\n                    >\n                      <div className=\"flex items-center gap-2 text-emerald-400 font-semibold\">\n                        <Zap className=\"w-4 h-4\" />\n                        <span>EV & Clean Mobility</span>\n                      </div>\n                      <span className=\"text-[11px] text-slate-400\">High-RPM Hollow Rotor Shafts</span>\n                    </a>\n                  </div>\n                  <div className=\"mt-3 pt-3 border-t border-white/10 flex items-center justify-between text-xs\">\n                    <span className=\"text-slate-400\">Full 3D Precision Catalog</span>\n                    <a href=\"#segments\" className=\"text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1\">\n                      View All 30+ Parts <ArrowRight className=\"w-3 h-3\" />\n                    </a>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Capabilities */}\n            <a\n              href=\"#capabilities\"\n              className=\"text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors\"\n            >\n              Capabilities\n            </a>\n\n            {/* In-House Machine Building */}\n            <a\n              href=\"#in-house-building\"\n              className=\"text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors flex items-center gap-1.5\"\n            >\n              <Cpu className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span>In-House Automation</span>\n            </a>\n\n            {/* Global Footprint */}\n            <a\n              href=\"#facilities\"\n              className=\"text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors flex items-center gap-1.5\"\n            >\n              <Factory className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>17+ Plants</span>\n            </a>\n\n            {/* Investors */}\n            <a\n              href=\"#investors\"\n              className=\"text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors\"\n            >\n              Investors\n            </a>\n\n            {/* OEM Partners */}\n            <a\n              href=\"#oem-partners\"\n              className=\"text-sm font-medium text-slate-200 hover:text-cyan-400 transition-colors\"\n            >\n              Global OEM Clients\n            </a>\n          </nav>\n\n          {/* Action CTAs */}\n          <div className=\"hidden lg:flex items-center gap-3\">\n            <button\n              onClick={onOpenFinancials}\n              className=\"px-3.5 py-2 text-xs font-semibold rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 border border-white/10 hover:border-cyan-500/40 transition-all flex items-center gap-1.5\"\n            >\n              <FileText className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span>Investor Kit</span>\n            </button>\n\n            <button\n              onClick={onOpenRfq}\n              className=\"relative group overflow-hidden px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-lg bg-gradient-to-r from-cyan-600 via-blue-600 to-cyan-500 text-white shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all active:scale-95\"\n            >\n              <span className=\"relative z-10 flex items-center gap-2\">\n                <span>Request RFQ</span>\n                <ArrowRight className=\"w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform\" />\n              </span>\n              <div className=\"absolute inset-0 bg-gradient-to-r from-blue-600 to-cyan-400 opacity-0 group-hover:opacity-100 transition-opacity\"></div>\n            </button>\n          </div>\n\n          {/* Mobile menu toggle */}\n          <div className=\"lg:hidden flex items-center gap-2\">\n            <button\n              onClick={onOpenRfq}\n              className=\"px-3 py-1.5 text-xs font-bold rounded-md bg-cyan-600 text-white\"\n            >\n              RFQ\n            </button>\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"p-2 rounded-lg bg-slate-900 border border-white/10 text-slate-200 hover:text-cyan-400 focus:outline-none\"\n              aria-label=\"Toggle navigation\"\n            >\n              {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile Menu Drawer */}\n      {mobileMenuOpen && (\n        <div className=\"lg:hidden bg-[#07090e]/98 border-b border-white/10 px-4 pt-4 pb-6 mt-3 space-y-4 backdrop-blur-2xl\">\n          <div className=\"grid grid-cols-2 gap-2 pb-3 border-b border-white/10\">\n            <button\n              onClick={() => {\n                onOpenFinancials();\n                setMobileMenuOpen(false);\n              }}\n              className=\"p-2.5 rounded-lg bg-slate-900 border border-white/10 text-xs font-semibold text-slate-200 text-left flex items-center gap-2\"\n            >\n              <FileText className=\"w-4 h-4 text-cyan-400\" />\n              <span>Investor Deck (PDF)</span>\n            </button>\n            <button\n              onClick={() => {\n                onOpenRfq();\n                setMobileMenuOpen(false);\n              }}\n              className=\"p-2.5 rounded-lg bg-cyan-950 border border-cyan-500/30 text-xs font-semibold text-cyan-200 text-left flex items-center gap-2\"\n            >\n              <Sparkles className=\"w-4 h-4 text-cyan-400\" />\n              <span>Engineering RFQ</span>\n            </button>\n          </div>\n\n          <div className=\"flex flex-col space-y-3 text-sm font-medium text-slate-200\">\n            <a \n              href=\"#about\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400 flex items-center justify-between\"\n            >\n              <span>Who We Are (Four Decades)</span>\n              <span className=\"text-xs text-cyan-400\">Est. 1981</span>\n            </a>\n            <a \n              href=\"#segments\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400 flex items-center justify-between\"\n            >\n              <span>Product Segments</span>\n              <span className=\"text-xs text-slate-400\">Auto, Aero, EV</span>\n            </a>\n            <a \n              href=\"#capabilities\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400\"\n            >\n              Engineering Capabilities\n            </a>\n            <a \n              href=\"#in-house-building\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400\"\n            >\n              In-House Machine Building\n            </a>\n            <a \n              href=\"#facilities\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400 flex items-center justify-between\"\n            >\n              <span>Manufacturing Facilities</span>\n              <span className=\"text-xs px-1.5 py-0.5 bg-slate-800 rounded\">17+ Plants</span>\n            </a>\n            <a \n              href=\"#sustainability\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400\"\n            >\n              ESG & Sustainability\n            </a>\n            <a \n              href=\"#investors\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400 flex items-center justify-between\"\n            >\n              <span>Investor Relations</span>\n              <span className=\"text-xs font-mono text-emerald-400\">\342\202\271{stockPrice}</span>\n            </a>\n            <a \n              href=\"#contact\" \n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-1 hover:text-cyan-400\"\n            >\n              Contact Global HQ\n            </a>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
