  file_change {
    absolute_path_uri: "file:///src/components/OEMPartners.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  ShieldCheck, \n  ArrowRight, \n  Sparkles, \n  Award, \n  CheckCircle2, \n  Car, \n  Plane, \n  Tractor,\n  Layers\n} from \'lucide-react\';\nimport { SANSERA_OEM_PARTNERS } from \'../data/sanseraData\';\nimport { OEMPartner } from \'../types\';\n\ninterface OEMPartnersProps {\n  onOpenRfq: () => void;\n}\n\nexport const OEMPartners: React.FC<OEMPartnersProps> = ({ onOpenRfq }) => {\n  const [selectedPartner, setSelectedPartner] = useState<OEMPartner>(SANSERA_OEM_PARTNERS[0]);\n  const [activeCategory, setActiveCategory] = useState<string>(\'All\');\n\n  const categories = [\'All\', \'Two-Wheeler\', \'Passenger Vehicle\', \'Commercial & Industrial\', \'Aerospace\'];\n\n  const filteredPartners = SANSERA_OEM_PARTNERS.filter(p => {\n    if (activeCategory === \'All\') return true;\n    return p.category === activeCategory;\n  });\n\n  return (\n    <section id=\"oem-partners\" className=\"py-24 bg-[#090d16] relative overflow-hidden border-t border-white/5\">\n      {/* Background ambient accents */}\n      <div className=\"absolute top-10 left-10 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n      <div className=\"absolute bottom-10 right-10 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none\"></div>\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Header */}\n        <div className=\"text-center max-w-3xl mx-auto mb-16 space-y-4\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/80 border border-cyan-500/30 text-xs font-mono font-bold tracking-widest text-cyan-300 uppercase\">\n            <Award className=\"w-3.5 h-3.5 text-cyan-400\" />\n            Direct Tier-1 OEM Relationships\n          </div>\n          <h2 className=\"text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-[\'Space_Grotesk\',sans-serif]\">\n            Trusted By The World\342\200\231s Leading{\' \'}\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-400\">\n              Automotive & Aerospace Giants\n            </span>\n          </h2>\n          <p className=\"text-base sm:text-lg text-slate-300 font-normal\">\n            Supplying critical powertrain, suspension, and flight-control assemblies with decades of uninterrupted Tier-1 delivery excellence.\n          </p>\n        </div>\n\n        {/* Category Pills */}\n        <div className=\"flex flex-wrap items-center justify-center gap-2 mb-12\">\n          {categories.map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setActiveCategory(cat)}\n              className={`px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all border ${\n                activeCategory === cat\n                  ? \'bg-cyan-500 text-black border-cyan-400 shadow-lg shadow-cyan-500/30\'\n                  : \'bg-slate-900 text-slate-400 border-white/5 hover:text-white hover:border-cyan-500/30\'\n              }`}\n            >\n              {cat}\n            </button>\n          ))}\n        </div>\n\n        {/* Partner Grid Cards */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-16\">\n          {filteredPartners.map((partner) => {\n            const isSelected = selectedPartner.id === partner.id;\n\n            return (\n              <div\n                key={partner.id}\n                onClick={() => setSelectedPartner(partner)}\n                className={`p-5 rounded-2xl border transition-all cursor-pointer flex flex-col justify-between text-center group relative overflow-hidden ${\n                  isSelected\n                    ? \'bg-gradient-to-b from-cyan-950 to-slate-900 border-cyan-500 shadow-xl shadow-cyan-950/60 scale-[1.03]\'\n                    : \'bg-slate-900/60 border-white/5 hover:border-cyan-500/40 text-slate-300\'\n                }`}\n              >\n                <div className=\"space-y-2\">\n                  <div className=\"text-[10px] font-mono uppercase tracking-wider text-slate-500 font-bold\">\n                    {partner.category}\n                  </div>\n                  <div className=\"text-base sm:text-lg font-black tracking-tight text-white group-hover:text-cyan-400 transition-colors font-mono\">\n                    {partner.logoText}\n                  </div>\n                  <div className=\"text-[11px] text-slate-400 line-clamp-1\">\n                    {partner.name}\n                  </div>\n                </div>\n\n                <div className=\"mt-4 pt-3 border-t border-white/5 text-[10px] font-mono text-cyan-400\">\n                  {partner.partnershipDuration.split(\' \')[0]} {partner.partnershipDuration.split(\' \')[1]}\n                </div>\n              </div>\n            );\n          })}\n        </div>\n\n        {/* Selected Partner Highlight Showcase Banner */}\n        <div className=\"p-8 rounded-3xl bg-gradient-to-r from-slate-900 via-[#0b101c] to-slate-900 border border-cyan-500/30 shadow-2xl flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8\">\n          <div className=\"space-y-3 max-w-2xl\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-mono font-bold border border-cyan-500/40\">\n                {selectedPartner.category}\n              </span>\n              <span className=\"text-xs text-slate-400 font-mono\">\n                {selectedPartner.partnershipDuration}\n              </span>\n            </div>\n\n            <h3 className=\"text-2xl sm:text-3xl font-extrabold text-white font-[\'Space_Grotesk\',sans-serif]\">\n              {selectedPartner.name}\n            </h3>\n\n            <div className=\"space-y-1.5\">\n              <span className=\"text-xs font-mono text-slate-400 uppercase font-bold block\">\n                Supplied Precision Components & Assemblies:\n              </span>\n              <div className=\"flex flex-wrap gap-2\">\n                {selectedPartner.suppliedComponents.map((comp, idx) => (\n                  <span key={idx} className=\"px-3 py-1 rounded-lg bg-black/50 border border-white/10 text-xs font-mono text-cyan-300\">\n                    {comp}\n                  </span>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          <div className=\"shrink-0 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full lg:w-auto\">\n            <button\n              onClick={onOpenRfq}\n              className=\"px-7 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-xs uppercase tracking-wider shadow-lg shadow-cyan-600/30 flex items-center justify-center gap-2 transition-all\"\n            >\n              <span>Onboard As OEM Client</span>\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
