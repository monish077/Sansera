        }
        lines {
          text: "        ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ctx.roundRect(-70 * cosA, -50, 140 * cosA, 100, 16);"
