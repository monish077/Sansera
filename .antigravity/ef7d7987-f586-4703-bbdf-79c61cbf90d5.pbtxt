    instruction: "Fix infinite update depth loop by using a ref for rotationAngle in canvas animation and remove setState from render loop"
    replacement_infos {
      original_chunk {
        target_content: "  const [activeCategory, setActiveCategory] = useState<ProductSegmentId>(initialSegment);\n  const [selectedProduct, setSelectedProduct] = useState<ProductItem>(SANSERA_PRODUCTS[0]);\n  const [isExplodedView, setIsExplodedView] = useState(false);\n  const [isWireframe, setIsWireframe] = useState(false);\n  const [rotationAngle, setRotationAngle] = useState(0);\n  const [isAutoRotating, setIsAutoRotating] = useState(true);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  const categories: { id: ProductSegmentId; label: string; icon: any; count: number; badge: string }[] = [\n    { id: \'automotive\', label: \'Automotive\', icon: Car, count: 3, badge: \'ICE & Hybrid\' },\n    { id: \'aerospace\', label: \'Aerospace\', icon: Plane, count: 1, badge: \'AS9100D Certified\' },\n    { id: \'non-automotive\', label: \'Non-Automotive\', icon: Tractor, count: 1, badge: \'Agri & Industrial\' },\n    { id: \'ev-mobility\', label: \'EV & Clean Mobility\', icon: Zap, count: 1, badge: \'Next-Gen E-Axle\' },\n  ];\n\n  const filteredProducts = SANSERA_PRODUCTS.filter(p => p.category === activeCategory);\n\n  useEffect(() => {\n    if (filteredProducts.length > 0) {\n      setSelectedProduct(filteredProducts[0]);\n    }\n  }, [activeCategory]);\n\n  // Interactive 3D Canvas Rendering of the Selected Mechanical Component (Crankshaft, Connecting Rod, Rocker Arm, Actuator)\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let animationFrameId: number;\n\n    const render = () => {\n      if (isAutoRotating) {\n        setRotationAngle(prev => (prev + 0.015) % (Math.PI * 2));\n      }\n\n      const w = canvas.width;\n      const h = canvas.height;\n      ctx.clearRect(0, 0, w, h);\n\n      const cx = w * 0.5;\n      const cy = h * 0.5;\n\n      // Dark metallic backdrop gradient\n      const bg = ctx.createRadialGradient(cx, cy, 30, cx, cy, w * 0.5);\n      bg.addColorStop(0, \'rgba(15, 23, 42, 0.9)\');\n      bg.addColorStop(0.8, \'rgba(7, 9, 14, 0.98)\');\n      bg.addColorStop(1, \'#05070c\');\n      ctx.fillStyle = bg;\n      ctx.fillRect(0, 0, w, h);\n\n      // Coordinate Measurement / Blueprint grid\n      ctx.strokeStyle = \'rgba(0, 180, 216, 0.12)\';\n      ctx.lineWidth = 1;\n      for (let x = 20; x < w; x += 40) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, h);\n        ctx.stroke();\n      }\n      for (let y = 20; y < h; y += 40) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(w, y);\n        ctx.stroke();\n      }\n\n      // Drawing 3D Precision Engineered CAD Representation based on selected product type\n      ctx.save();\n      ctx.translate(cx, cy);\n\n      const rad = rotationAngle;\n      const cosA = Math.cos(rad);\n      const sinA = Math.sin(rad);"
        replacement_content: "  const [activeCategory, setActiveCategory] = useState<ProductSegmentId>(initialSegment);\n  const [selectedProduct, setSelectedProduct] = useState<ProductItem>(SANSERA_PRODUCTS[0]);\n  const [isExplodedView, setIsExplodedView] = useState(false);\n  const [isWireframe, setIsWireframe] = useState(false);\n  const [isAutoRotating, setIsAutoRotating] = useState(true);\n  const rotationRef = useRef(0);\n  const canvasRef = useRef<HTMLCanvasElement | null>(null);\n\n  const categories: { id: ProductSegmentId; label: string; icon: any; count: number; badge: string }[] = [\n    { id: \'automotive\', label: \'Automotive\', icon: Car, count: 3, badge: \'ICE & Hybrid\' },\n    { id: \'aerospace\', label: \'Aerospace\', icon: Plane, count: 1, badge: \'AS9100D Certified\' },\n    { id: \'non-automotive\', label: \'Non-Automotive\', icon: Tractor, count: 1, badge: \'Agri & Industrial\' },\n    { id: \'ev-mobility\', label: \'EV & Clean Mobility\', icon: Zap, count: 1, badge: \'Next-Gen E-Axle\' },\n  ];\n\n  // Sync when initialSegment prop changes\n  useEffect(() => {\n    if (initialSegment) {\n      setActiveCategory(initialSegment);\n    }\n  }, [initialSegment]);\n\n  const filteredProducts = SANSERA_PRODUCTS.filter(p => p.category === activeCategory);\n\n  useEffect(() => {\n    if (filteredProducts.length > 0) {\n      setSelectedProduct(filteredProducts[0]);\n    }\n  }, [activeCategory]);\n\n  // Interactive 3D Canvas Rendering of the Selected Mechanical Component (Crankshaft, Connecting Rod, Rocker Arm, Actuator)\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let animationFrameId: number;\n\n    const render = () => {\n      if (isAutoRotating) {\n        rotationRef.current = (rotationRef.current + 0.015) % (Math.PI * 2);\n      }\n\n      const w = canvas.width;\n      const h = canvas.height;\n      ctx.clearRect(0, 0, w, h);\n\n      const cx = w * 0.5;\n      const cy = h * 0.5;\n\n      // Dark metallic backdrop gradient\n      const bg = ctx.createRadialGradient(cx, cy, 30, cx, cy, w * 0.5);\n      bg.addColorStop(0, \'rgba(15, 23, 42, 0.9)\');\n      bg.addColorStop(0.8, \'rgba(7, 9, 14, 0.98)\');\n      bg.addColorStop(1, \'#05070c\');\n      ctx.fillStyle = bg;\n      ctx.fillRect(0, 0, w, h);\n\n      // Coordinate Measurement / Blueprint grid\n      ctx.strokeStyle = \'rgba(0, 180, 216, 0.12)\';\n      ctx.lineWidth = 1;\n      for (let x = 20; x < w; x += 40) {\n        ctx.beginPath();\n        ctx.moveTo(x, 0);\n        ctx.lineTo(x, h);\n        ctx.stroke();\n      }\n      for (let y = 20; y < h; y += 40) {\n        ctx.beginPath();\n        ctx.moveTo(0, y);\n        ctx.lineTo(w, y);\n        ctx.stroke();\n      }\n\n      // Drawing 3D Precision Engineered CAD Representation based on selected product type\n      ctx.save();\n      ctx.translate(cx, cy);\n\n      const rad = rotationRef.current;\n      const cosA = Math.cos(rad);\n      const sinA = Math.sin(rad);"
