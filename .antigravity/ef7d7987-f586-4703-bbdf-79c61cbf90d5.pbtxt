        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  useEffect(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filteredProducts.length > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
